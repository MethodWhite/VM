// Higher-order function: pasa lambda como parametro.
//
// `apply` recibe un fn(i32) -> i32 y un i32, llama fn(x) y devuelve.
// Test verifica que un function value puede pasarse como argumento.
//
// Resultado esperado: R0 = 100 (10 * 10).

i32 apply(fn(i32) -> i32 f, i32 x) {
    return f(x);
}

i32 main() {
    fn(i32) -> i32 sq = (i32 n) => n * n;
    return apply(sq, 10);
}
