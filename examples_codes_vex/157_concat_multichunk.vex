// optimizacion O(N) para concat MULTI-CHUNK `s = s + X + Y + ...`.
//
// Antes solo el patron simple `s = s + X` era O(N).  El parser
// asocia el `+` a izquierda, asi que `s = s + to_str(i) + ","` se baja
// como `Add(Add(s, to_str(i)), ",")` -- el lhs del outer Add NO es
// IdentExpr(s) sino otro BinaryExpr.  Eso bypaseaba el fast path y
// caia al fallback O(N) por iter (O(N^2) sobre el loop).
//
// Ahora: la fast path desciende recursivamente por la cadena
// de Add asociada por izquierda hasta encontrar el `s` en el fondo, y
// appendea cada rhs intermedio en sitio.  Cero alocaciones de vector
// temporal por iter (descenso recursivo + append directo).
//
// Transaccional: si la cadena falla a mitad (e.g. uno de los chunks
// no es comptime-evaluable), se restaura el binding al snapshot inicial.
//
// Mediciones reales (TDM-GCC release, Win10):
//
//   Patron `s = s + to_str(i) + ","` (multi-chunk con CallExpr):
//
//   N        Antes A.43.19 (O(N^2))   Despues A.43.21 (O(N))    Speedup
//   ----     ---------------------    ----------------------    -------
//   25K      241 ms                   ~50 ms                    ~5x
//   50K      614 ms                   ~60 ms                    ~10x
//   100K     3045 ms                  ~90 ms                    ~34x
//   200K     19044 ms                 ~125 ms                   ~150x
//   400K     >75000 ms                ~210 ms                   ~350x
//
//   Patron `s = s + "X" + "Y"` (multi-chunk con literales):
//
//   N        Antes (O(N^2))           Despues (O(N))            Speedup
//   ----     --------------           --------------            -------
//   100K     778 ms                   ~60 ms                    ~13x
//   200K     3500 ms                  ~80 ms                    ~45x
//   400K     ~14000 ms                ~120 ms                   ~115x

i32 doblar(i32 x) { return x * 2; }

comptime u64 build_csv(i64 n) {
    comptime var string s = "";
    comptime var i64 i = 0;
    while (i < n) {
        // 3 chunks: to_str(i) + "," + " "  -- todos en una sola asignacion.
        s = s + to_str(i) + "," + " ";
        i = i + 1;
    }
    return strlen(s);
}

comptime u64 build_lit3(i64 n) {
    comptime var string s = "";
    comptime var i64 i = 0;
    while (i < n) {
        s = s + "[" + "X" + "]";
        i = i + 1;
    }
    return strlen(s);
}

comptime u64 build_mixed(i64 n) {
    comptime var string s = "";
    comptime var i64 i = 0;
    while (i < n) {
        s = s + "row=" + to_str(i) + ";";
        i = i + 1;
    }
    return strlen(s);
}

i32 main() {
    static_assert(build_csv(1000)  > 1000,    "csv 3-chunk linear");
    static_assert(build_lit3(1000) == 3000,   "lit3 == 3*N");
    static_assert(build_mixed(1000) > 1000,   "mixed");
    return 42;
}
