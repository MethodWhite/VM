/*
 * ejemplo_subsp_addsp.vel
 *
 * Demuestra SUBSP y ADDSP: instrucciones para ajustar RSP o RBP con un
 * inmediato de 64 bits.
 *
 * Son la forma natural de reservar y liberar espacio en la pila para
 * variables locales dentro de una funcion (prologo y epilogo).
 *
 * Instrucciones:
 *
 *   SUBSP rsp, N    ; RSP -= N  (reservar N bytes en la pila)
 *   ADDSP rsp, N    ; RSP += N  (liberar N bytes de la pila)
 *   SUBSP rbp, N    ; RBP -= N
 *   ADDSP rbp, N    ; RBP += N
 *
 * El inmediato N ocupa siempre 8 bytes en el encoding (modo 64 bits).
 * El tamano total de la instruccion es 11 bytes: 2 opcode + 1 ctrl + 8 imm.
 *
 * Patron de prologo/epilogo:
 *
 *   push  rbp
 *   mov   rbp, rsp
 *   subsp rsp, N    ; reservar N bytes para variables locales
 *   ; ... cuerpo ...
 *   addsp rsp, N    ; liberar las variables locales
 *   pop   rbp
 *   ret
 *
 * Compilar y ejecutar:
 *   vesta --build ejemplo_subsp_addsp.vel -o ejemplo_subsp_addsp
 *   vesta --run   ejemplo_subsp_addsp.velb --stats
 *
 * Resultado esperado:
 *   R0 = 42   (valor calculado y devuelto por la funcion)
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

// -----------------------------------------------------------------------
// Punto de entrada
// -----------------------------------------------------------------------
code:
    // Inicializar la pila en una zona de memoria valida
    mov rsp, 0x00FF0000
    mov rbp, 0x00FF0000

    // Llamar a la funcion que usa un frame de pila
    mov   r1, @Absolute("all.mi_funcion")
    call  r1

    // R0 debe contener el valor de retorno (42)
    hlt
end_code:

// -----------------------------------------------------------------------
// mi_funcion: demuestra prologo/epilogo con SUBSP/ADDSP
//
// Variables locales en la pila:
//   [RBP - 8]  = variable local a  (tipo uint64)
//   [RBP - 16] = variable local b  (tipo uint64)
// -----------------------------------------------------------------------
mi_funcion:
    // --- PROLOGO ---
    // Guardar RBP del llamante y establecer el frame base
    push  rbp
    mov   rbp, rsp

    // Reservar 16 bytes para dos variables locales de 8 bytes cada una
    subsp rsp, 16

    // --- CUERPO ---
    // Escribir variable local a = 10  en [RBP - 8]
    mov   r1, 10
    movc  [rbp - 8], r1         // guardar en la pila

    // Escribir variable local b = 32  en [RBP - 16]
    mov   r2, 32
    movc  [rbp - 16], r2        // guardar en la pila

    // Leer las variables y sumarlas -> R0 = a + b = 42
    movc  r3, [rbp - 8]         // leer a
    movc  r4, [rbp - 16]        // leer b
    addu  r0, r3, r4            // R0 = 42

    // --- EPILOGO ---
    // Liberar las variables locales y restaurar RBP
    addsp rsp, 16
    pop   rbp
    ret
end_mi_funcion:
