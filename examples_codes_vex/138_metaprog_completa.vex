// metaprogramacion completa al nivel de Nim.
//
// (1) `comptime NAME = expr;` local (dentro de funciones)
// (2) `comptime { ... }` bloque scope para constantes / asserts compile-time
// (3) `comptime for (i in lo..hi) { body }` loop unrolled, i const por iter
// (4) Operadores string compile-time: comptime_concat / comptime_streq / comptime_strlen
// (5) `comptime T NAME(params) { body }` funciones compile-time recursivas

@Introspect
struct Vec3 { f64 x; f64 y; f64 z; }

// --- (5) Funciones compile-time recursivas.
comptime i64 fact(i64 n) {
    if (n <= 1) return 1;
    return n * fact(n - 1);
}

comptime i64 fib(i64 n) {
    if (n <= 1) return n;
    return fib(n - 1) + fib(n - 2);
}

comptime i64 pow_int(i64 base, i64 e) {
    if (e <= 0) return 1;
    return base * pow_int(base, e - 1);
}

// --- (1) comptime global con builtins comptime.
comptime string TYPE_NAME = typename<Vec3>();
comptime u64    TYPE_SZ   = sizeof<Vec3>();
comptime u64    F10       = fact(10);          // 3628800
comptime u64    F15       = fib(15);           // 610

// --- (4) Operadores string.
comptime string PREFIX = "vec_";
comptime string COMBINED = comptime_concat(PREFIX, TYPE_NAME);   // "vec_Vec3"
comptime u64 COMBINED_LEN = comptime_strlen(COMBINED);            // 8

// --- static_assert sobre todos los anteriores.
static_assert(F10 == 3628800,          "fact(10)");
static_assert(F15 == 610,              "fib(15)");
static_assert(pow_int(2, 12) == 4096,  "2^12");
static_assert(comptime_streq(TYPE_NAME, "Vec3"),       "typename");
static_assert(comptime_streq(COMBINED, "vec_Vec3"),    "concat");
static_assert(COMBINED_LEN == 8,                       "strlen");
static_assert(TYPE_SZ == 24,                           "sizeof Vec3");

i32 main() {
    // --- (1) comptime local con builtins + fns recursivas.
    comptime i64 LOCAL_F6  = fact(6);     // 720
    comptime i64 SQ_5      = pow_int(5, 2); // 25

    // --- (2) Bloque comptime con vars locales scoped y static_assert.
    comptime {
        comptime i64 DOUBLE = LOCAL_F6 * 2;     // 1440
        static_assert(DOUBLE == 1440,                 "DOUBLE wrong");
        static_assert(SQ_5 == 25,                     "SQ_5 wrong");
    }

    // --- (3) comptime for desenrollado con index const.
    i64 sum_facts = 0;
    comptime for (k in 1..6) {
        sum_facts = sum_facts + fact(k);   // fact(k) inline como CONST cada iter
    }
    // sum_facts = 1+2+6+24+120 = 153

    // comptime for + comptime dentro del body (cada iter es scope nuevo).
    i64 product = 1;
    comptime for (j in 2..=5) {
        comptime i64 SQ = j * j;     // j const en cada iter
        product = product + SQ;             // 4+9+16+25 = 54
    }

    // Validar todo.
    i32 ok = 0;
    if (LOCAL_F6 == 720)       ok = ok + 6;
    if (SQ_5 == 25)            ok = ok + 6;
    if (sum_facts == 153)      ok = ok + 6;
    if (product == 1 + 54)     ok = ok + 6;
    if (F10 == 3628800)        ok = ok + 6;
    if (F15 == 610)            ok = ok + 6;
    if (COMBINED_LEN == 8)     ok = ok + 6;
    return ok;   // 6 * 7 = 42
}
