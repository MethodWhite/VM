/*
 * ejemplo_collections_hashmap.vel
 *
 * Demuestra el uso de VestaHashMap: tabla hash uint64_t -> uint64_t.
 * Implementacion interna: direccionamiento abierto + sondeo lineal, FNV-1a.
 *
 * Funciones usadas:
 *   vcol_map_new(cap)            r1=cap          -> r0=handle
 *   vcol_map_put(h, key, val)    r1=h, r2=k, r3=v
 *   vcol_map_get(h, key)         r1=h, r2=key    -> r0=valor (0 si no existe)
 *   vcol_map_contains(h, key)    r1=h, r2=key    -> r0=1/0
 *   vcol_map_size(h)             r1=h             -> r0=pares almacenados
 *   vcol_map_remove(h, key)      r1=h, r2=key    -> r0=valor anterior
 *   vcol_map_keys(h)             r1=h             -> r0=VestaArrayList handle
 *   vcol_map_free(h)             r1=h
 *   vcol_alist_size(h)           r1=h             -> r0=size (para el keys list)
 *   vcol_alist_free(h)           r1=h
 *
 * Secuencia del test:
 *   1. Crear mapa con capacidad 16
 *   2. put(100, 1000), put(200, 2000), put(300, 3000)
 *   3. size debe ser 3
 *   4. get(200) debe devolver 2000
 *   5. contains(300) debe devolver 1
 *   6. contains(999) debe devolver 0
 *   7. Actualizar: put(200, 2500)
 *   8. get(200) debe devolver 2500  (actualizacion)
 *   9. remove(100) debe devolver 1000, size=2
 *  10. keys() devuelve ArrayList con 2 elementos
 *  11. free del mapa y del keys list
 *
 * Resultado esperado en registros al llegar a hlt:
 *   r8  = 3     (size tras 3 put)
 *   r9  = 2000  (get(200) antes de update)
 *   r10 = 1     (contains(300))
 *   r11 = 0     (contains(999))
 *   r12 = 2500  (get(200) tras update)
 *   r13 = 1000  (remove(100))
 *   r14 = 2     (size tras remove)
 *   r7  = 2     (keys list size)
 *
 * Compilar y ejecutar:
 *   ./vm --build ejemplo_collections_hashmap.vel -o ejemplo_collections_hashmap
 *   ./vm --run   ejemplo_collections_hashmap.velb
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("all"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

@Import {
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_new")      }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_put")      }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_get")      }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_contains") }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_size")     }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_remove")   }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_keys")     }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_map_free")     }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_alist_size")   }
    @Method { @Lib("stdlib/native/collections/vesta_collections") @Name("vcol_alist_free")   }
}

code:
    mov rsp, 0x00FF0000
    mov rbp, 0x00FF0000

    // -----------------------------------------------------------------------
    // 1. Crear VestaHashMap con capacidad 16
    //    vcol_map_new(16) -> r0 = handle
    // -----------------------------------------------------------------------
    mov  r1, 16
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_new")
    mov  r5, r0                           // r5 = handle del mapa

    // -----------------------------------------------------------------------
    // 2. Insertar tres pares: (100->1000), (200->2000), (300->3000)
    //    vcol_map_put(handle, key, value)  -- sin valor de retorno
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 100
    mov  r3, 1000
    mov  r15, 3
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_put")

    mov  r1, r5
    mov  r2, 200
    mov  r3, 2000
    mov  r15, 3
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_put")

    mov  r1, r5
    mov  r2, 300
    mov  r3, 3000
    mov  r15, 3
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_put")

    // -----------------------------------------------------------------------
    // 3. size debe ser 3 -> r8
    //    vcol_map_size(handle) -> r0
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_size")
    mov  r8, r0                           // r8 = 3

    // -----------------------------------------------------------------------
    // 4. get(200) debe devolver 2000 -> r9
    //    vcol_map_get(handle, key) -> r0
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 200
    mov  r15, 2
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_get")
    mov  r9, r0                           // r9 = 2000

    // -----------------------------------------------------------------------
    // 5. contains(300) debe devolver 1 -> r10
    //    vcol_map_contains(handle, key) -> r0 = 1/0
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 300
    mov  r15, 2
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_contains")
    mov  r10, r0                          // r10 = 1

    // -----------------------------------------------------------------------
    // 6. contains(999) debe devolver 0 -> r11
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 999
    mov  r15, 2
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_contains")
    mov  r11, r0                          // r11 = 0

    // -----------------------------------------------------------------------
    // 7. Actualizar: put(200, 2500) -- sobreescribe el valor existente
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 200
    mov  r3, 2500
    mov  r15, 3
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_put")

    // -----------------------------------------------------------------------
    // 8. get(200) debe devolver 2500 -> r12
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 200
    mov  r15, 2
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_get")
    mov  r12, r0                          // r12 = 2500

    // -----------------------------------------------------------------------
    // 9. remove(100) debe devolver 1000, size=2
    //    vcol_map_remove(handle, key) -> r0 = valor eliminado
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r2, 100
    mov  r15, 2
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_remove")
    mov  r13, r0                          // r13 = 1000

    mov  r1, r5
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_size")
    mov  r14, r0                          // r14 = 2

    // -----------------------------------------------------------------------
    // 10. keys() devuelve VestaArrayList con las claves restantes (200, 300)
    //     vcol_map_keys(handle) -> r0 = handle VestaArrayList
    // -----------------------------------------------------------------------
    mov  r1, r5
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_keys")
    mov  r6, r0                           // r6 = handle keys list

    mov  r1, r6
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_alist_size")
    mov  r7, r0                           // r7 = 2 (claves restantes)

    // -----------------------------------------------------------------------
    // 11. Liberar el keys list y el mapa
    // -----------------------------------------------------------------------
    mov  r1, r6
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_alist_free")

    mov  r1, r5
    mov  r15, 1
    calln @Method("stdlib/native/collections/vesta_collections:vcol_map_free")

    // Resultado esperado:
    //   r8  = 3     (size inicial)
    //   r9  = 2000  (get 200 antes de update)
    //   r10 = 1     (contains 300)
    //   r11 = 0     (contains 999)
    //   r12 = 2500  (get 200 tras update)
    //   r13 = 1000  (remove 100)
    //   r14 = 2     (size tras remove)
    //   r7  = 2     (keys list size)
    mov  r0, r8
    hlt
