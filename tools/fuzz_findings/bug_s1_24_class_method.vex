class Calc {
 public i64 total;
 public i32 k;
 public Calc(i32 init) { this.total = (i64)init; this.k = 3; }
 public i64 step(i32 x) {
   i64 v = (i64)x * (i64)this.k;
   this.total = this.total + imin((i64)this.k, v);
   this.total = this.total + v ^ (i64)this.k ^ (i64)(x << 2);
   return this.total;
 }
}

i32 main() {
Calc c = new Calc(5);
i64 a64 = 0;
i32 i = 0;
while (i < 17) {
a64 = a64 ^ c.step(i);
i = i + 1;
}
i32 r = (i32)(a64 & 0xffffffff);
}