/*
 * test_oop_callvirt.vel
 *
 * Prueba de despacho dinamico via vtable con CALLVIRT y CALLSUPER.
 *
 * Si R13 == 3 al llegar a hlt: los 3 callvirt/callsuper funcionaron.
 *
 * Offsets REALES de MethodInfo (112 bytes):
 *   +72 code_vaddr (8B)
 *
 * Offsets REALES de ClassInfo (136 bytes):
 *   +80 vtable** (8B)   +88 vtable_size (8B)
 *
 * Offsets REALES de ObjectHeader (24 bytes, ABI v2):
 *   +0  class_ptr  (8B)    +8  flags      (4B dword)
 *   +12 hash_code  (4B)    +16 owner_pid  (4B)
 *   +20 lock_depth (2B)    +22 _mon_pad   (2B)
 *
 * NOTA: "xchg cur0, rN" DESTRUYE rN. Patron seguro:
 *   mov r14, rN / xchg cur0, r14
 *
 * alloc() devuelve memoria zeroeada.
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:
    mov   rbp, 0x8000
    mov   rsp, 0x8000
    mov   r13, 0

// -----------------------------------------------------------------------
// 1. MethodInfo para method_body  (112 bytes)  -> r1
// -----------------------------------------------------------------------
    mov   r3, 144
    alloc r3
    mov   r1, r0

    // code_vaddr (offset 72) = virtual address de method_body
    mov   r14, r1
    addu  r14, 72
    xchg  cur0, r14
    mov   r5, @Absolute("code.method_body")
    writecur cur0, r5

// -----------------------------------------------------------------------
// 2. MethodInfo para method_body2  (112 bytes)  -> r9
// -----------------------------------------------------------------------
    mov   r3, 144
    alloc r3
    mov   r9, r0

    // code_vaddr (offset 72) = virtual address de method_body2
    mov   r14, r9
    addu  r14, 72
    xchg  cur0, r14
    mov   r5, @Absolute("code.method_body2")
    writecur cur0, r5

// -----------------------------------------------------------------------
// 3. vtable con 2 entradas: [r1, r9]  (16 bytes)  -> r6
// -----------------------------------------------------------------------
    mov   r3, 16
    alloc r3
    mov   r6, r0

    // vtable[0] = method_body MethodInfo (r1)
    mov   r14, r6
    xchg  cur0, r14
    writecur cur0, r1

    // vtable[1] = method_body2 MethodInfo (r9)
    mov   r14, r6
    addu  r14, 8
    xchg  cur0, r14
    writecur cur0, r9

// -----------------------------------------------------------------------
// 4. ClassInfo  (136 bytes)  -> r2
//    vtable = r6, vtable_size = 2
// -----------------------------------------------------------------------
    mov   r3, 168
    alloc r3
    mov   r2, r0

    // vtable (offset 80) = r6
    mov   r14, r2
    addu  r14, 80
    xchg  cur0, r14
    writecur cur0, r6

    // vtable_size (offset 88) = 2
    mov   r14, r2
    addu  r14, 88
    xchg  cur0, r14
    mov   r5, 2
    writecur cur0, r5

// -----------------------------------------------------------------------
// 5. ObjectHeader  (24 bytes, ABI v2)  -> r4
//    class_ptr = r2, flags = 2 (OBJ_FLAG_RAW_OWNED)
// -----------------------------------------------------------------------
    mov   r3, 24
    alloc r3
    mov   r4, r0

    // class_ptr (offset 0) = ClassInfo*
    mov   r14, r4
    xchg  cur0, r14
    writecur cur0, r2

    // flags (offset 8, dword) = 2
    mov   r14, r4
    addu  r14, 8
    xchg  cur0, r14
    mov   r5, 2
    writecur cur0, r5d

// -----------------------------------------------------------------------
// T1: CALLVIRT r4, 0  ->  method_body
// -----------------------------------------------------------------------
    callvirt r4, 0
    mov   r13, 1                          // r13 = 1 si CALLVIRT+RET funciono

// -----------------------------------------------------------------------
// T2: CALLVIRT r4, 1  ->  method_body2
// -----------------------------------------------------------------------
    callvirt r4, 1
    addu  r13, 1                          // r13 = 2

// -----------------------------------------------------------------------
// T3: CALLSUPER r2, 0  ->  llama vtable[0] directamente
// -----------------------------------------------------------------------
    callsuper r2, 0
    addu  r13, 1                          // r13 = 3

    // R13 == 3 significa exito total
    hlt

// -----------------------------------------------------------------------
// method_body: funcion trivial #1
// -----------------------------------------------------------------------
method_body:
    enter 0
    leave
    ret

// -----------------------------------------------------------------------
// method_body2: funcion trivial #2
// -----------------------------------------------------------------------
method_body2:
    enter 0
    leave
    ret

end_code:
