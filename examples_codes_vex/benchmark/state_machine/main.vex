// Bench: state machine 8 estados (lexer-like).
// 10M tokens procesados con 1 transicion por byte.

i32 main() {
    i32 state = 0;
    i64 counts = 0;
    u64 rng = 7;
    i32 i = 0;
    while (i < 10000000) {
        rng = rng * 6364136223846793005;
        rng = rng + 1442695040888963407;
        u8 byte = (u8) ((rng >> 33) & 0xFF);
        if (state == 0) {
            if (byte < 32) { state = 1; } else { state = 2; }
        } else if (state == 1) {
            if (byte < 64) { state = 3; } else { state = 4; }
        } else if (state == 2) {
            if (byte < 96) { state = 5; } else { state = 6; }
        } else if (state == 3) {
            state = 7;
        } else if (state == 4) {
            state = 7;
        } else if (state == 5) {
            state = 0;
            counts = counts + 1;
        } else if (state == 6) {
            state = 0;
            counts = counts + 1;
        } else {
            state = 0;
        }
        i = i + 1;
    }
    return (i32) (counts & 0xFFFF);
}
