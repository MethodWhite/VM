// Optional via instrucciones VM isnull/unwrap.
//
// Modelo (consistente con la VM):
//   - Cualquier referencia (CLASS) es NULLABLE por defecto.
//   - El literal `null` representa "ausente".
//   - Builtin `isPresent(x)` -> i32: 1 si x != null, 0 si x == null.
//     Lowering directo a la instruccion bytecode `isnull` (0x25)
//     (invertida con XOR 1).
//   - Builtin `unwrap(x)` -> tipo de x: x si != null, lanza
//     NullPointerException si null.  Lowering directo a la instruccion
//     bytecode `unwrap` (0x26).
//
// Esto NO es una clase de alto nivel basada en templates; es directo
// a las instrucciones de la VM.  El template Optional<T> se descarta
// porque el modelo nullable + isnull/unwrap ya cubre los reference
// types completos.  Para wrap escalares se usa una clase Box<T> normal.
//
// Test:
//   - a = new Box(50)             -> isPresent(a) = 1, unwrap(a).val = 50
//   - b = null  (typed Box)        -> isPresent(b) = 0
//   - main devuelve unwrap(a).val + (1 - isPresent(b)) * 1000 = 50 + 1000 = 1050.

class Box {
    public i32 val;
    public Box(i32 v) { this.val = v; }
}

i32 main() {
    Box a = new Box(50);
    Box b = null;          // null reference asignable a Box

    i32 has_b = isPresent(b);   // 0
    i32 res = 0;
    if (has_b == 0) {
        res = res + 1000;
    }
    Box ua = unwrap(a);          // ua = a (no null), no excepcion
    res = res + ua.val;          // 50

    return res;                  // 1050
}
