// std.biology.alignment - Pairwise sequence alignment
// Needleman-Wunsch (global) and Smith-Waterman (local) alignment algorithms.

namespace std.biology {

    type AlignmentResult = struct {
        score: f64,
        aligned_a: string,
        aligned_b: string,
        matches: i32,
        mismatches: i32,
        gaps: i32,
        identity: f64
    }

    fn needleman_wunsch(seq_a: Sequence, seq_b: Sequence, match_score: f64, mismatch_penalty: f64, gap_penalty: f64) -> AlignmentResult {
        let a = seq_a.nucleotides
        let b = seq_b.nucleotides
        let n = seq_a.length
        let m = seq_b.length

        let cols = m + 1
        let total = (n + 1) * cols

        let mut dp: f64[] = []
        let mut tb: i32[] = []
        let mut i: i32 = 0
        while i < total {
            dp = dp ++ [0.0]
            tb = tb ++ [0]
            i = i + 1
        }

        tb[0] = -1
        i = 1
        while i <= n {
            dp[i * cols + 0] = f64(i) * gap_penalty
            tb[i * cols + 0] = 1
            i = i + 1
        }
        let mut j: i32 = 1
        while j <= m {
            dp[0 * cols + j] = f64(j) * gap_penalty
            tb[0 * cols + j] = 2
            j = j + 1
        }

        i = 1
        while i <= n {
            j = 1
            while j <= m {
                let diag = dp[(i - 1) * cols + (j - 1)] + (if a[i - 1] == b[j - 1] { match_score } else { mismatch_penalty })
                let up = dp[(i - 1) * cols + j] + gap_penalty
                let left = dp[i * cols + (j - 1)] + gap_penalty

                let mut best = diag
                let mut dir: i32 = 0
                if up > best { best = up; dir = 1 }
                if left > best { best = left; dir = 2 }

                dp[i * cols + j] = best
                tb[i * cols + j] = dir
                j = j + 1
            }
            i = i + 1
        }

        let mut aligned_a: string = ""
        let mut aligned_b: string = ""
        i = n
        j = m
        let mut matches: i32 = 0
        let mut mismatches: i32 = 0
        let mut gaps: i32 = 0

        while tb[i * cols + j] != -1 {
            let dir = tb[i * cols + j]
            if dir == 0 {
                if a[i - 1] == b[j - 1] {
                    matches = matches + 1
                } else {
                    mismatches = mismatches + 1
                }
                aligned_a = a[i - 1] ++ aligned_a
                aligned_b = b[j - 1] ++ aligned_b
                i = i - 1
                j = j - 1
            } else if dir == 1 {
                aligned_a = a[i - 1] ++ aligned_a
                aligned_b = '-' ++ aligned_b
                gaps = gaps + 1
                i = i - 1
            } else {
                aligned_a = '-' ++ aligned_a
                aligned_b = b[j - 1] ++ aligned_b
                gaps = gaps + 1
                j = j - 1
            }
        }

        let total_comp = matches + mismatches + gaps
        let identity = if total_comp > 0 { f64(matches) / f64(total_comp) * 100.0 } else { 0.0 }

        return AlignmentResult {
            score: dp[n * cols + m],
            aligned_a: aligned_a,
            aligned_b: aligned_b,
            matches: matches,
            mismatches: mismatches,
            gaps: gaps,
            identity: identity
        }
    }

    fn smith_waterman(seq_a: Sequence, seq_b: Sequence, match_score: f64, mismatch_penalty: f64, gap_penalty: f64) -> AlignmentResult {
        let a = seq_a.nucleotides
        let b = seq_b.nucleotides
        let n = seq_a.length
        let m = seq_b.length

        let cols = m + 1
        let total = (n + 1) * cols

        let mut dp: f64[] = []
        let mut tb: i32[] = []
        let mut i: i32 = 0
        while i < total {
            dp = dp ++ [0.0]
            tb = tb ++ [-1]
            i = i + 1
        }

        let mut max_score: f64 = 0.0
        let mut max_i: i32 = 0
        let mut max_j: i32 = 0

        i = 1
        while i <= n {
            j = 1
            while j <= m {
                let diag = dp[(i - 1) * cols + (j - 1)] + (if a[i - 1] == b[j - 1] { match_score } else { mismatch_penalty })
                let up = dp[(i - 1) * cols + j] + gap_penalty
                let left = dp[i * cols + (j - 1)] + gap_penalty

                let mut best: f64 = 0.0
                let mut dir: i32 = -1
                if diag > best { best = diag; dir = 0 }
                if up > best { best = up; dir = 1 }
                if left > best { best = left; dir = 2 }

                dp[i * cols + j] = best
                tb[i * cols + j] = dir

                if best > max_score {
                    max_score = best
                    max_i = i
                    max_j = j
                }
                j = j + 1
            }
            i = i + 1
        }

        let mut aligned_a: string = ""
        let mut aligned_b: string = ""
        i = max_i
        j = max_j
        let mut matches: i32 = 0
        let mut mismatches: i32 = 0
        let mut gaps: i32 = 0

        while tb[i * cols + j] != -1 {
            let dir = tb[i * cols + j]
            if dir == 0 {
                if a[i - 1] == b[j - 1] {
                    matches = matches + 1
                } else {
                    mismatches = mismatches + 1
                }
                aligned_a = a[i - 1] ++ aligned_a
                aligned_b = b[j - 1] ++ aligned_b
                i = i - 1
                j = j - 1
            } else if dir == 1 {
                aligned_a = a[i - 1] ++ aligned_a
                aligned_b = '-' ++ aligned_b
                gaps = gaps + 1
                i = i - 1
            } else {
                aligned_a = '-' ++ aligned_a
                aligned_b = b[j - 1] ++ aligned_b
                gaps = gaps + 1
                j = j - 1
            }
        }

        let total_comp = matches + mismatches + gaps
        let identity = if total_comp > 0 { f64(matches) / f64(total_comp) * 100.0 } else { 0.0 }

        return AlignmentResult {
            score: max_score,
            aligned_a: aligned_a,
            aligned_b: aligned_b,
            matches: matches,
            mismatches: mismatches,
            gaps: gaps,
            identity: identity
        }
    }

} // namespace std.biology
