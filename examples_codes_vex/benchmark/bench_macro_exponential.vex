// EXTREME stress: macros compuestos exponencialmente.

i32 doblar(i32 x) { return x * 2; }

// Cada nivel duplica el tamano del codigo emitido.
@Macro comptime string L0(i64 v) { return to_str(v); }
@Macro comptime string L1(i64 v) { return L0(v) + " + " + L0(v); }
@Macro comptime string L2(i64 v) { return L1(v) + " + " + L1(v); }
@Macro comptime string L3(i64 v) { return L2(v) + " + " + L2(v); }
@Macro comptime string L4(i64 v) { return L3(v) + " + " + L3(v); }
@Macro comptime string L5(i64 v) { return L4(v) + " + " + L4(v); }
@Macro comptime string L6(i64 v) { return L5(v) + " + " + L5(v); }
@Macro comptime string L7(i64 v) { return L6(v) + " + " + L6(v); }
@Macro comptime string L8(i64 v) { return L7(v) + " + " + L7(v); }

// L8(1) -> 256 sumas de "1" = 256 emitidas como expresion.

// Macro recursivo que construye una pirámide.
@Macro comptime string Pyramid(i64 n) {
    return (n <= 0)
        ? "0"
        : "(" + Pyramid(n - 1) + " + " + Pyramid(n - 1) + ")";
}

// Pyramid(8) = 2^8 - 1 = 255 expansiones recursivas.

i32 main() {
    // L8(1) inyecta 256 "1 + 1 + ..." = 256.
    i32 r1 = L8(1);

    // Pyramid(8): cada nivel duplica, total = 2^8 nodos.
    i32 r2 = Pyramid(8);

    if (r1 != 256) return 91;
    if (r2 != 0)   return 92;
    return 42;
}
