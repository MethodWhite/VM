// =============================================================================
// test_interpolation_loop.vex - reproduce el patron de render_tab_bar:
// loop con interpolacion de string + print + acceso a field de class
// despues del print.
// =============================================================================

public class Item {
    public i32 id;
    public string title;
    public Item next;
    public Item(i32 i, string t) {
        this.id = i;
        this.title = t;
        this.next = null;
    }
}

public class Container {
    public Item head;
    public i32 count;
    public Container() {
        this.head = null;
        this.count = 0;
    }
    public void add(i32 id, string title) {
        Item it = new Item(id, title);
        if (this.head == null) {
            it.next = it;
            this.head = it;
        } else {
            Item h = this.head;
            // Buscar el ultimo (head.next.next...prev).  Para 1 elem head.next=head.
            Item last = h;
            while (last.next != h) last = last.next;
            last.next = it;
            it.next = h;
        }
        this.count = this.count + 1;
    }
}

// Reproduce render_tab_bar: interpolacion en loop + print + cur=cur.next.
public i32 run() {
    Container c = new Container();
    c.add(1, "untitled-1");

    // Render 20 frames como hace el main loop del editor.
    i32 frame = 0;
    while (frame < 20) {
        Item cur = c.head;
        i32 idx = 1;
        i32 sum_ids = 0;
        while (idx <= c.count) {
            string mark = "";
            string label = " ${idx} ${cur.title}${mark} ";
            i32 lblen = (i32) str_bytes(label);
            if (lblen <= 0) return 100 + frame;
            sum_ids = sum_ids + cur.id;
            // Crucial: acceso a cur.next DESPUES de interpolacion + str_bytes call.
            cur = cur.next;
            idx = idx + 1;
        }
        if (sum_ids != 1) return 200 + frame;
        frame = frame + 1;
    }
    return 0;
}
