// metaprogramacion imperativa completa.
// (1) `comptime var T NAME = expr;` -- variable comptime mutable
// (2) Asignacion + compound assign a comptime vars en contexto comptime
// (3) while/for/do-while loops dentro de `comptime fn` y `comptime { }`
// (4) break/continue en loops comptime

// comptime fn con loop while + var mutable (sin recursion).
comptime i64 sum_iter(i64 n) {
    comptime var i64 acc = 0;
    comptime var i64 i = 1;
    while (i <= n) {
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

// comptime fn con if + break (return temprano).
comptime i64 find_div(i64 start, i64 d) {
    comptime var i64 k = start;
    while (k < 1000000) {
        if (k % d == 0) return k;
        k = k + 1;
    }
    return -1;
}

// comptime fn con continue.
comptime i64 sum_odd(i64 n) {
    comptime var i64 acc = 0;
    comptime var i64 i = 0;
    while (i <= n) {
        if (i % 2 == 0) {
            i = i + 1;
            continue;
        }
        acc = acc + i;
        i = i + 1;
    }
    return acc;
}

// comptime fn con while iterativo.
comptime i64 prod(i64 n) {
    comptime var i64 p = 1;
    comptime var i64 i = 1;
    while (i <= n) {
        p = p * i;
        i = i + 1;
    }
    return p;
}

// Constantes computadas en compile-time.
comptime const i64 S100  = sum_iter(100);      // 5050
comptime const i64 D100  = find_div(100, 7);   // 105 (105 = 15*7)
comptime const i64 ODD9  = sum_odd(9);          // 1+3+5+7+9 = 25
comptime const i64 P6    = prod(6);             // 720

static_assert(S100 == 5050,  "sum_iter(100)");
static_assert(D100 == 105,   "find_div(100, 7)");
static_assert(ODD9 == 25,    "sum_odd(9)");
static_assert(P6 == 720,     "prod(6) = fact(6)");

i32 main() {
    // comptime block con var mutable + while.
    comptime {
        comptime var u64 power = 1;
        comptime var u64 e = 0;
        while (e < 10) {
            power = power * 2;
            e = e + 1;
        }
        static_assert(power == 1024, "2^10 != 1024");
    }

    // comptime block con compound assignments.
    comptime {
        comptime var i64 x = 100;
        x += 23;          // 123
        x *= 2;           // 246
        x -= 5;           // 241
        x /= 3;           // 80
        x %= 17;          // 80 % 17 = 12
        x |= 0x40;        // 12 | 64 = 76
        x &= 0xFF;        // 76
        x ^= 4;           // 76 ^ 4 = 72
        x <<= 1;          // 144
        x >>= 2;          // 36
        static_assert(x == 36, "compound assign chain");
    }

    // comptime block con break en while.
    comptime {
        comptime var i64 i = 0;
        comptime var i64 stop_at = 0;
        while (i < 1000) {
            if (i * i > 100) {
                stop_at = i;
                break;
            }
            i = i + 1;
        }
        static_assert(stop_at == 11, "first i with i*i > 100");
    }

    return 42;
}
