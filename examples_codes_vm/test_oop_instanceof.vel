/*
 * test_oop_instanceof.vel
 *
 * Construye una jerarquia de dos clases en memoria host y verifica
 * INSTANCEOF y CHECKCAST con transitividad:
 *
 *   ClassParent (sin supers)
 *       |
 *   ClassChild  (supers[0] = ClassParent)
 *
 * Objeto de tipo ClassChild:
 *   INSTANCEOF(obj, ClassChild)    -> 1   (misma clase)
 *   INSTANCEOF(obj, ClassParent)   -> 1   (transitivo via supers[0])
 *   INSTANCEOF(obj, ClassUnrelated)-> 0   (sin relacion)
 *
 *   CHECKCAST(null, cualquiera)    -> 0   (null pasa siempre)
 *   CHECKCAST(obj, ClassChild)     -> obj ptr
 *   CHECKCAST(obj, ClassParent)    -> obj ptr  (subclase pasa)
 *
 * Tambien verifica GCALLOC: reserva un buffer GC sin ObjectHeader
 * y lo accede via GCDEREF + cursor.
 *
 * Offsets REALES de ClassInfo (136 bytes):
 *   +32 supers* (8B)   +40 super_count (8B)
 *
 * Offsets REALES de ObjectHeader (24 bytes, ABI v2):
 *   +0 class_ptr (8B)  +8 flags (4B dword)
 *
 * NOTA: "xchg cur0, rN" DESTRUYE rN. Patron seguro:
 *   mov r14, rN / xchg cur0, r14
 *
 * alloc() devuelve memoria zeroeada.
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:

// -----------------------------------------------------------------------
// 1. ClassParent (136 bytes, zeroeado)  -> r1
// -----------------------------------------------------------------------
    mov   r1, 168
    alloc r1
    mov   r1, r0

// -----------------------------------------------------------------------
// 2. ClassChild (136 bytes, zeroeado)  -> r2
// -----------------------------------------------------------------------
    mov   r3, 168
    alloc r3
    mov   r2, r0

// -----------------------------------------------------------------------
// 3. Supers array para ClassChild: [ClassParent]  (8 bytes)  -> r3
// -----------------------------------------------------------------------
    mov   r5, 8
    alloc r5
    mov   r3, r0

    // supers[0] = ClassParent* (r1)
    mov   r14, r3
    xchg  cur0, r14
    writecur cur0, r1

// -----------------------------------------------------------------------
// 4. Configurar ClassChild.supers (offset 32) y super_count (offset 40)
// -----------------------------------------------------------------------
    // ClassChild.supers (offset 32) = r3
    mov   r14, r2
    addu  r14, 32
    xchg  cur0, r14
    writecur cur0, r3

    // ClassChild.super_count (offset 40) = 1
    mov   r14, r2
    addu  r14, 40
    xchg  cur0, r14
    mov   r5, 1
    writecur cur0, r5

// -----------------------------------------------------------------------
// 5. ObjectHeader del objeto de tipo ClassChild  (24 bytes, ABI v2)  -> r4
//    class_ptr = ClassChild*, flags = 2 (OBJ_FLAG_RAW_OWNED)
// -----------------------------------------------------------------------
    mov   r5, 24
    alloc r5
    mov   r4, r0

    // ObjectHeader.class_ptr (offset 0) = ClassChild*
    mov   r14, r4
    xchg  cur0, r14
    writecur cur0, r2

    // ObjectHeader.flags (offset 8) = 2 (OBJ_FLAG_RAW_OWNED)
    mov   r14, r4
    addu  r14, 8
    xchg  cur0, r14
    mov   r5, 2
    writecur cur0, r5d

// -----------------------------------------------------------------------
// T1: INSTANCEOF(obj, ClassChild) -> R0 = 1  (clase exacta)
// -----------------------------------------------------------------------
    instanceof r4, r2
    mov   r9, r0                          // r9 = 1

// -----------------------------------------------------------------------
// T2: INSTANCEOF(obj, ClassParent) -> R0 = 1  (transitivo via supers[0])
// -----------------------------------------------------------------------
    instanceof r4, r1
    mov   r10, r0                         // r10 = 1

// -----------------------------------------------------------------------
// 6. ClassUnrelated (136 bytes, zeroeado, sin parentesco)  -> r5
// -----------------------------------------------------------------------
    mov   r6, 168
    alloc r6
    mov   r5, r0

// -----------------------------------------------------------------------
// T3: INSTANCEOF(obj, ClassUnrelated) -> R0 = 0
// -----------------------------------------------------------------------
    instanceof r4, r5
    mov   r11, r0                         // r11 = 0

// -----------------------------------------------------------------------
// T4: CHECKCAST(null, cualquiera) -> R0 = 0  (null pasa siempre)
// -----------------------------------------------------------------------
    mov       r6, 0
    checkcast r6, r2
    mov   r12, r0                         // r12 = 0

// -----------------------------------------------------------------------
// T5: CHECKCAST(obj, ClassChild) -> R0 = r4  (misma clase)
// -----------------------------------------------------------------------
    checkcast r4, r2
    mov   r13, r0                         // r13 = r4

// -----------------------------------------------------------------------
// T6: CHECKCAST(obj, ClassParent) -> R0 = r4  (subclase pasa)
// -----------------------------------------------------------------------
    checkcast r4, r1
    mov   r14, r0                         // r14 = r4

// -----------------------------------------------------------------------
// T7: GCALLOC de un buffer de 256 bytes sin ClassInfo
//     R0 = GcHandle (distinto de GC_NULL_HANDLE = 0xFFFFFFFF)
// -----------------------------------------------------------------------
    mov      r6, 256
    gcalloc  r6                           // R0 = GcHandle
    mov      r15, r0                      // r15 = handle

    gcderef  cur1, r15                    // cur1 = payload ptr del buffer GC

    // Escribir y leer un valor para confirmar que el payload es accesible
    mov      r7, 0xCAFEBABE
    writecur cur1, r7                     // buf[0] = 0xCAFEBABE

    gcderef  cur1, r15                    // re-deref (GC puede haber movido el objeto)
    readcur  r8, cur1                     // r8 = 0xCAFEBABE

    drop     r15                          // liberar el handle

    // Resultado esperado al llegar a hlt:
    //   r9  = 1  (instanceof exacta)
    //   r10 = 1  (instanceof transitiva)
    //   r11 = 0  (instanceof sin relacion)
    //   r12 = 0  (checkcast null)
    //   r13 = r4 (checkcast misma clase)
    //   r14 = r4 (checkcast subclase)
    //   r8  = 0xCAFEBABE
    hlt

end_code:
