/**
 * ejemplo_sum_range.ir
 * Suma de todos los enteros en [lo, hi]: sum_range(lo, hi) -> i64
 *
 * Conceptos demostrados:
 *   - Bucle con dos phi nodes: suma acumulada e indice
 *   - Patron de acumulacion (sum += i)
 *   - Caso especial: rango vacio (lo > hi) retorna 0
 *
 * Algoritmo:
 *   if lo > hi: return 0
 *   sum = 0, i = lo
 *   while i <= hi: sum += i; i++
 *   return sum
 *
 * Nota matematica: la formula cerrada es (hi-lo+1)*(lo+hi)/2,
 * pero este ejemplo sirve para mostrar el patron de bucle acumulador.
 *
 * Compilar:
 *   vm --ir-file examples_ir/ejemplo_sum_range.ir --ir-opt 2 -o build/out_ir/sum_range
 */

@module ejemplo_sum_range

// Suma todos los enteros del intervalo cerrado [lo, hi].
// Retorna 0 si lo > hi.
@function sum_range(lo: i64, hi: i64) -> i64 {
entry:
    // Caso degenerado: rango vacio
    empty = cmp.gt.i64 lo, hi
    br.cond empty, ret_zero, loop_init

ret_zero:
    zero_v = const.i64 0
    ret.i64 zero_v

loop_init:
    // Estado inicial: sum=0, i=lo
    s0    = const.i64 0
    br    loop_check

loop_check:
    // Phi: sum_c acumula la suma; i_c recorre [lo, hi]
    sum_c = phi.i64 [s0,  loop_init], [sum_next, loop_body]
    i_c   = phi.i64 [lo,  loop_init], [i_next,   loop_body]
    // Condicion de salida: i > hi
    done  = cmp.gt.i64 i_c, hi
    br.cond done, loop_exit, loop_body

loop_body:
    sum_next = add.i64 sum_c, i_c   // sum += i
    one      = const.i64 1
    i_next   = add.i64 i_c, one     // i++
    br       loop_check

loop_exit:
    ret.i64 sum_c    // suma total de lo..hi
}
