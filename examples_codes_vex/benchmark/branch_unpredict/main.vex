// Bench: branches no predecibles (xorshift) + 4 branches.
i32 main() {
    u64 rng = 1;
    i64 a = 0; i64 b = 0; i64 c = 0; i64 d = 0;
    i32 i = 0;
    while (i < 10000000) {
        rng = rng ^ (rng << 13);
        rng = rng ^ (rng >> 7);
        rng = rng ^ (rng << 17);
        if ((rng & 1) != 0) { a = a + 1; } else { a = a - 1; }
        if ((rng & 2) != 0) { b = b + 1; } else { b = b - 1; }
        if ((rng & 4) != 0) { c = c + 1; } else { c = c - 1; }
        if ((rng & 8) != 0) { d = d + 1; } else { d = d - 1; }
        i = i + 1;
    }
    return (i32)((a + b + c + d) & 0xFF);
}
