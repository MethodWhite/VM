// =============================================================================
// test_syntax_smoke.vex - smoke no-interactivo del syntax highlighter
// =============================================================================
//
// Crea un Editor, escribe codigo Vex de muestra al buffer, hace 1 render
// y sale.  Verifica visualmente (o por captura de stdout) que keywords,
// tipos, numeros, strings y comentarios salen coloreados.

#include "modules/keys.vh"
#include "modules/input_backend.vh"
#include "modules/screen.vh"
#include "modules/file_io.vh"
#include "modules/buffer.vh"
#include "modules/extension_api.vh"
#include "modules/syntax_vex.vh"
#include "modules/editor_core.vh"

void fill_test_code(Editor ed) {
    string sample = "class Foo {\n    public i32 x;\n    public Foo() { this.x = 42; }\n    // comentario\n    public i32 sum(i32 a, i32 b) { return a + b; }\n}\n\ni32 main() {\n    Foo f = new Foo();\n    string s = \"hola\";\n    i32 n = 0xDEAD;\n    return f.sum(n, 10);\n}\n";
    u8* raw = str_cstr(sample);
    i32 len = str_bytes(sample);
    i32 i = 0;
    while (i < len) {
        ed.buffer.insert_char(raw[i]);
        i = i + 1;
    }
    ed.buffer.cursor = 0;
}

i32 main() {
    Editor ed = new Editor();
    fill_test_code(ed);
    ed.render();
    ed.screen.move_cursor(ed.screen.rows + 1, 1);
    ed.screen.show_cursor();
    print("\n[test_syntax_smoke ok]\n");
    flush();
    return 0;
}
