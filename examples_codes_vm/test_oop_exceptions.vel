/*
 * test_oop_exceptions.vel
 *
 * Prueba el mecanismo completo de excepcion:
 *   THROW -> busqueda de handler en FrameHeader -> salto al handler
 *
 * R13 == 0x5A al llegar a hlt => TEST PASADO.
 *
 * Offsets REALES de HandlerException (24 bytes):
 *   +0  type* (8B)   +8  start_pc (4B dword)   +12 end_pc (4B dword)
 *   +16 handler_pc (4B dword)
 *
 * Offsets REALES de MethodInfo (112 bytes):
 *   +72 code_vaddr (8B)   +88 handlers* (8B)   +96 handler_count (8B)
 *
 * Offsets REALES de ClassInfo (136 bytes):
 *   +80 vtable** (8B)   +88 vtable_size (8B)
 *
 * NOTA: "xchg cur0, rN" DESTRUYE rN. Patron seguro:
 *   mov r14, rN / xchg cur0, r14
 *
 * alloc() devuelve memoria zeroeada.
 */

@Format("raw")

@SpaceAddress {
    @Name("anonymous"),
    @IniAddress(0x0000000000000000),
    @EndAddress(0xFFFFFFFFFFFFFFFF)
}

@Section {
    @Name("code"),
    @SpaceAddress("anonymous")
    @Align(0x1000)
}

code:
    mov   rbp, 0x8000
    mov   rsp, 0x8000
    mov   r13, 0

// -----------------------------------------------------------------------
// 1. ExcClassInfo (ClassInfo zeroeada)  -> r9
// -----------------------------------------------------------------------
    mov   r3, 168
    alloc r3
    mov   r9, r0

// -----------------------------------------------------------------------
// 2. ExcObj (ObjectHeader, 24 bytes ABI v2)  -> r10
//    class_ptr = ExcClassInfo, flags = 2 (OBJ_FLAG_RAW_OWNED)
// -----------------------------------------------------------------------
    mov   r3, 24
    alloc r3
    mov   r10, r0

    // class_ptr (offset 0) = ExcClassInfo*
    mov   r14, r10
    xchg  cur0, r14
    writecur cur0, r9

    // flags (offset 8, dword) = 2
    mov   r14, r10
    addu  r14, 8
    xchg  cur0, r14
    mov   r5, 2
    writecur cur0, r5d

// -----------------------------------------------------------------------
// 3. HandlerException (24 bytes)  -> r7
//    catch-all: type=0(null), start_pc=0, end_pc=4, handler_pc=4
// -----------------------------------------------------------------------
    mov   r3, 24
    alloc r3
    mov   r7, r0

    // type (offset 0) = null (catch-all) - already 0 from alloc

    // start_pc (offset 8, dword) = 0 - already 0

    // end_pc (offset 12, dword) = 4
    mov   r14, r7
    addu  r14, 12
    xchg  cur0, r14
    mov   r5, 4
    writecur cur0, r5d

    // handler_pc (offset 16, dword) = 4
    mov   r14, r7
    addu  r14, 16
    xchg  cur0, r14
    mov   r5, 4
    writecur cur0, r5d

// -----------------------------------------------------------------------
// 4. TryMethodInfo (112 bytes)  -> r1
//    code_vaddr = @try_method (offset 72)
//    handlers = r7           (offset 88)
//    handler_count = 1       (offset 96)
// -----------------------------------------------------------------------
    mov   r3, 144
    alloc r3
    mov   r1, r0

    // code_vaddr (offset 72) = @try_method
    mov   r14, r1
    addu  r14, 72
    xchg  cur0, r14
    mov   r5, @Absolute("code.try_method")
    writecur cur0, r5

    // handlers (offset 88) = HandlerException*
    mov   r14, r1
    addu  r14, 88
    xchg  cur0, r14
    writecur cur0, r7

    // handler_count (offset 96) = 1
    mov   r14, r1
    addu  r14, 96
    xchg  cur0, r14
    mov   r5, 1
    writecur cur0, r5

// -----------------------------------------------------------------------
// 5. vtable (8 bytes) con vtable[0] = TryMethodInfo  -> r6
// -----------------------------------------------------------------------
    mov   r3, 8
    alloc r3
    mov   r6, r0

    mov   r14, r6
    xchg  cur0, r14
    writecur cur0, r1

// -----------------------------------------------------------------------
// 6. ClassInfo receptor (136 bytes)  -> r2
//    vtable = r6 (offset 80), vtable_size = 1 (offset 88)
// -----------------------------------------------------------------------
    mov   r3, 168
    alloc r3
    mov   r2, r0

    // vtable (offset 80) = r6
    mov   r14, r2
    addu  r14, 80
    xchg  cur0, r14
    writecur cur0, r6

    // vtable_size (offset 88) = 1
    mov   r14, r2
    addu  r14, 88
    xchg  cur0, r14
    mov   r5, 1
    writecur cur0, r5

// -----------------------------------------------------------------------
// 7. ObjectHeader receptor (24 bytes, ABI v2)  -> r4
//    class_ptr = ClassInfo receptor, flags = 2
// -----------------------------------------------------------------------
    mov   r3, 24
    alloc r3
    mov   r4, r0

    // class_ptr (offset 0) = ClassInfo receptor*
    mov   r14, r4
    xchg  cur0, r14
    writecur cur0, r2

    // flags (offset 8, dword) = 2
    mov   r14, r4
    addu  r14, 8
    xchg  cur0, r14
    mov   r5, 2
    writecur cur0, r5d

// -----------------------------------------------------------------------
// T1: CALLVIRT -> try_method -> THROW -> catch_handler -> RET
//   R13 debe ser 0x5A al retornar
// -----------------------------------------------------------------------
    callvirt r4, 0

    // Llegamos aqui si el handler capto la excepcion y hizo RET
    // R13 = 0x5A indica exito
    hlt

// -----------------------------------------------------------------------
// try_method: codigo virtual con bloque try
//
//   +0: throw r10     (4 bytes FIXED_4) <- try [0, 4)
//   +4: catch_handler:
//       mov r13, 0x5A
//       ret
// -----------------------------------------------------------------------
try_method:
    throw r10                             // lanza ExcObj (host ptr)

catch_handler:
    mov   r13, 0x5A                       // marca de exito
    ret                                   // vuelve al caller del CALLVIRT

end_code:
