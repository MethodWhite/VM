// opengl_bindings.vex - Example of auto-generated OpenGL bindings
// This file demonstrates what vexbindgen produces when processing a
// subset of the OpenGL API headers (gl.h / glew.h).
//
// Generated by vexbindgen --module opengl32 opengl.h

namespace opengl32 {

    // ----------------------------------------
    //  Enum constants
    // ----------------------------------------

    const GL_COLOR_BUFFER_BIT : i32 = 0x00004000
    const GL_DEPTH_BUFFER_BIT : i32 = 0x00000100
    const GL_STENCIL_BUFFER_BIT : i32 = 0x00000400

    const GL_TRIANGLES : i32 = 0x0004
    const GL_TRIANGLE_STRIP : i32 = 0x0005
    const GL_TRIANGLE_FAN : i32 = 0x0006

    const GL_ARRAY_BUFFER : i32 = 0x8892
    const GL_ELEMENT_ARRAY_BUFFER : i32 = 0x8893
    const GL_STATIC_DRAW : i32 = 0x88E4
    const GL_DYNAMIC_DRAW : i32 = 0x88E8

    const GL_FLOAT : i32 = 0x1406
    const GL_INT : i32 = 0x1404
    const GL_UNSIGNED_INT : i32 = 0x1405
    const GL_UNSIGNED_BYTE : i32 = 0x1401

    const GL_FALSE : i32 = 0
    const GL_TRUE : i32 = 1

    // ----------------------------------------
    //  Struct definitions
    // ----------------------------------------

    @Packed
    type GLfloat = struct { value: f32 }

    @Packed
    type GLint = struct { value: i32 }

    // ----------------------------------------
    //  External function declarations
    // ----------------------------------------

    // --- OpenGL 1.x / 2.x core ---

    @Extern("opengl32:glClear")
    fn glClear(mask: u32)

    @Extern("opengl32:glClearColor")
    fn glClearColor(red: f32, green: f32, blue: f32, alpha: f32)

    @Extern("opengl32:glClearDepth")
