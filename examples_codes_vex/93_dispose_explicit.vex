// examples_codes_vex/93_dispose_explicit.vex
//
// dispose(xs) explicito + auto-free idempotente.
//
// Permite liberar antes del exit del scope cuando el programador lo
// necesite (ej. bucle largo que crea/desecha colecciones temporales sin
// esperar al exit de la funcion).  El cleanup automatico al exit del
// scope sigue corriendo: como el handle se setea a 0 tras dispose y el
// free fn del plugin ya hace null-check, es no-op (no double-free).
//
// Esperado: R00 == 42.

i32 main() {
    ArrayList xs = arraylist(16);
    xs.push(1); xs.push(2); xs.push(3);
    i64 sz1 = xs.size();              // 3

    // Liberacion explicita: el handle queda a 0.
    dispose(xs);

    // Crear nueva coleccion con el mismo nombre.
    xs = arraylist(8);
    xs.push(100); xs.push(200);
    i64 sz2 = xs.size();              // 2

    // sz1 + sz2 = 5 -> retorno 42 con math sencilla:
    // (3 + 2) * 8 + 2 = 42.
    i64 result = (sz1 + sz2) * 8 + 2;
    i32 r32 = result;
    return r32;

    // Al exit del scope, el cleanup automatico llama free(xs).
    // El binding actual de xs es la 2a coleccion (no la 1a, que ya fue
    // disposed).  free no-op si xs hubiera sido disposed tambien.
}
