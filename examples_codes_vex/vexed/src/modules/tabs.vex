// =============================================================================
// modules/tabs.vex - Workspace de pestanas para vexed.
// =============================================================================

import "modules/buffer";
import "modules/history";

i32 g_next_id = 1;

public class EditorTab {
    public i32                      id;
    public buffer.Buffer            buf;
    public string                   title;
    public i32                      row_top;
    public string                   last_needle;
    public history.SnapshotStack    undo;
    public history.SnapshotStack    redo;

    public EditorTab next;
    public EditorTab prev;

    public EditorTab(string title) {
        this.id          = g_next_id;
        g_next_id        = g_next_id + 1;
        this.buf         = new buffer.Buffer();
        this.title       = title;
        this.row_top     = 0;
        this.last_needle = "";
        this.undo        = new history.SnapshotStack();
        this.redo        = new history.SnapshotStack();
        this.next        = this;
        this.prev        = this;
    }
}

public class Workspace {
    public EditorTab active;
    public i32       count;

    public Workspace() {
        this.active = null;
        this.count  = 0;
    }

    public void open_tab(EditorTab t) {
        if (this.active == null) {
            t.next = t;
            t.prev = t;
            this.active = t;
        } else {
            EditorTab after = this.active.next;
            t.prev = this.active;
            t.next = after;
            this.active.next = t;
            after.prev = t;
            this.active = t;
        }
        this.count = this.count + 1;
    }

    public i32 close_active() {
        if (this.active == null) return 0;
        if (this.count == 1) {
            this.active = null;
            this.count  = 0;
            return 1;
        }
        EditorTab dead = this.active;
        EditorTab nxt  = dead.next;
        EditorTab prv  = dead.prev;
        prv.next = nxt;
        nxt.prev = prv;
        this.active = nxt;
        this.count  = this.count - 1;
        return 1;
    }

    public void next_tab() {
        if (this.active != null) this.active = this.active.next;
    }

    public void prev_tab() {
        if (this.active != null) this.active = this.active.prev;
    }
}
