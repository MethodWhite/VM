// examples_codes_vex/11_arrays_nativos.vex
//
// Demuestra arrays nativos:
//   - T[N] reserva un bloque contiguo de N*sizeof(T) bytes en stack via
//     ALLOCA del IR; el lowering trata el nombre del array como su
//     direccion base (igual que para structs).
//   - T[] (sin tamano) solo se admite como tipo de parametro de funcion;
//     equivale a T* via decay-to-pointer.
//   - Pasar un T[N] a una funcion que espera T[] funciona automaticamente
//     (types_assignable cubre el decay).
//   - El subscript arr[i] usa LOAD/STORE de memoria VM (no host) porque
//     el array vive en stack: el bit is_host_ptr permanece false.
//
// Compilar y ejecutar:
//   vm --vex examples_codes_vex/11_arrays_nativos.vex -o an
//   vm --run an.velb --stats
//
// Resultado esperado: R00 == 55  (1+2+3+...+10)

i32 sum_array(i32[] xs, i32 n) {
    i32 s = 0;
    i32 i = 0;
    while (i < n) {
        s = s + xs[i];
        i = i + 1;
    }
    return s;
}

i32 main() {
    i32[10] arr;
    i32 i = 0;
    while (i < 10) {
        arr[i] = i + 1;
        i = i + 1;
    }
    return sum_array(arr, 10);
}
