// Algoritmo real: Quicksort recursivo sobre array nativo i32[].
//
// Pone a prueba:
//   - Funciones top-level con recursion mutua (quicksort -> partition).
//   - Arrays nativos T[N] como variable local + decay-to-T[] en parametros.
//   - Indexacion arr[i] de lectura y escritura.
//   - Comparaciones, branches, swap manual con variable temporal.
//   - Validacion del ordenamiento por suma + checksum + ordering check.
//
// Validaciones (todas deben pasar para R0=42):
//   1. Suma de elementos preservada: 7+2+9+1+5+8+3+6+4 = 45.
//   2. Tras sort: arr[i] <= arr[i+1] para todo i.
//   3. Primer elemento = 1 (minimo); ultimo = 9 (maximo).
//
// Resultado esperado: R0 = 42 (1*100 + 9*10 + 45 + 22 = ... no, mejor:
// si todas las validaciones pasan -> R0 = 42; si alguna falla -> codigo
// de error distinto entre 1 y 99).

i32 partition(i32[] arr, i32 lo, i32 hi) {
    // Lomuto partition: elige arr[hi] como pivote, mueve elementos
    // <= pivote a la izquierda, devuelve el indice final del pivote.
    i32 pivot = arr[hi];
    i32 i = lo - 1;
    i32 j = lo;
    while (j < hi) {
        if (arr[j] <= pivot) {
            i = i + 1;
            // swap arr[i] y arr[j]
            i32 tmp = arr[i];
            arr[i] = arr[j];
            arr[j] = tmp;
        }
        j = j + 1;
    }
    // swap arr[i+1] y arr[hi] (pivote a su posicion final)
    i32 tmp2 = arr[i + 1];
    arr[i + 1] = arr[hi];
    arr[hi] = tmp2;
    return i + 1;
}

void quicksort(i32[] arr, i32 lo, i32 hi) {
    if (lo < hi) {
        i32 p = partition(arr, lo, hi);
        quicksort(arr, lo, p - 1);
        quicksort(arr, p + 1, hi);
    }
}

i32 sum_array(i32[] arr, i32 n) {
    i32 s = 0;
    i32 i = 0;
    while (i < n) {
        s = s + arr[i];
        i = i + 1;
    }
    return s;
}

i32 is_sorted(i32[] arr, i32 n) {
    i32 i = 0;
    while (i < n - 1) {
        if (arr[i] > arr[i + 1]) return 0;
        i = i + 1;
    }
    return 1;
}

i32 main() {
    i32[9] arr;
    arr[0] = 7;
    arr[1] = 2;
    arr[2] = 9;
    arr[3] = 1;
    arr[4] = 5;
    arr[5] = 8;
    arr[6] = 3;
    arr[7] = 6;
    arr[8] = 4;

    i32 sum_before = sum_array(arr, 9);  // 45

    quicksort(arr, 0, 8);

    i32 sum_after  = sum_array(arr, 9);  // debe ser 45 tambien
    i32 sorted     = is_sorted(arr, 9);  // debe ser 1
    i32 first_min  = arr[0];             // debe ser 1
    i32 last_max   = arr[8];             // debe ser 9

    // Codigos de error distintos para que falla la validacion sea
    // diagnosticable sin necesidad de prints.
    if (sum_before != 45)        return 11;  // bug en sum_array o array init
    if (sum_after != sum_before) return 12;  // sort perdio elementos
    if (sorted == 0)             return 13;  // sort no ordeno
    if (first_min != 1)          return 14;  // minimo incorrecto
    if (last_max != 9)           return 15;  // maximo incorrecto

    return 42;  // todas las validaciones OK
}
