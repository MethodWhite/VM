// =============================================================================
// VEXED MODULAR - Editor TUI Vex con extensiones runtime
// =============================================================================
//
// Editor de codigo dividido en modulos (`#include`) y con un sistema de
// extensiones runtime: el syntax-highlighter es un .velb separado cargado
// via `loadmodule(...)` + invocado via reflexion (forName + newInstance +
// getMethod + invoke), no un modulo compile-time.
//
// Modulos:
//   modules/keys.vh           constantes KEY_*/VK_*
//   modules/input_backend.vh  class InputBackend (FFI msvcrt + user32)
//   modules/screen.vh         class Screen (ANSI render)
//   modules/file_io.vh        class FileIO (FFI msvcrt fopen/fwrite/fclose)
//   modules/buffer.vh         class Buffer (buffer plano u8* + cursor)
//   modules/extension_api.vh  class ExtensionRegistry (4 slots, dispatch via invoke)
//   modules/editor_core.vh    class Editor (orquestador + ciclo principal)
//
// Extensiones runtime:
//   extensions/ext_syntax_vex.velb   syntax-highlight para Vex (clase ExtSyntaxVex)
//
// Compilacion:
//   ./vm --vex extensions/ext_syntax_vex.vex -o extensions/ext_syntax_vex
//   ./vm --vex vexed_modular.vex -o vexedm
//
// Uso:
//   ./vm --run vexedm.velb              # editor con scratch buffer
//   ./vm --run vexedm.velb mi_archivo.vex   # carga mi_archivo.vex al arrancar

#include "modules/keys.vh"
#include "modules/input_backend.vh"
#include "modules/screen.vh"
#include "modules/file_io.vh"
#include "modules/buffer.vh"
#include "modules/extension_api.vh"
#include "modules/file_explorer.vh"
#include "modules/config.vh"
#include "modules/sidebar.vh"
#include "modules/autocomplete.vh"
#include "modules/multi_cursor.vh"
#include "modules/editor_core.vh"

// Para ACTIVAR/DESACTIVAR el debug logging, cambia esta constante a 1 o 0.
// Cuando esta activo, el editor escribe trazas en `vexed_debug.log` con
// numero de secuencia + mensaje + flush por linea (sobrevive a un crash).
// Solo se usa para depurar; en uso normal poner a 0.
const i32 ENABLE_DEBUG_LOG = 1;

i32 main() {
    Editor ed = new Editor();

    if (ENABLE_DEBUG_LOG == 1) {
        ed.dlog_open("vexed_debug.log");
        ed.dlog("main: editor creado, log activo");
    }

    // Cargar dos extensiones runtime que componen via el dispatcher:
    //   slot 0: ExtLineNo (gutter de numeros de linea, prefijo + return 0)
    //   slot 1: ExtSyntaxVex (syntax-highlight, contenido + return 1)
    // Cada linea visible: el dispatcher invoca slot 0 -> imprime " NNNN |",
    // continua al slot 1 -> imprime contenido coloreado, corta el dispatch.
    i32 lineno_ok = 0;
    i32 syntax_ok = 0;

    ed.dlog("main: pre loadmodule ext_lineno");
    i64 lm1 = loadmodule("extensions/ext_lineno.velb");
    ed.dlog_i("main: lm1=", lm1);
    if (lm1 != 0) {
        Class  cls = Class.forName("ExtLineNo");
        ed.dlog("main: forName ExtLineNo OK");
        Object ins = cls.newInstance();
        ed.dlog("main: newInstance OK");
        Method mr  = cls.getMethod("on_render_line");
        Method mk  = cls.getMethod("on_keypress");
        ed.dlog("main: getMethod OK");
        lineno_ok  = ed.exts.register_handles(cls, ins, mr, mk);
        ed.dlog_i("main: register_handles ExtLineNo lineno_ok=", lineno_ok);
    }

    ed.dlog("main: pre loadmodule ext_syntax_vex");
    i64 lm2 = loadmodule("extensions/ext_syntax_vex.velb");
    ed.dlog_i("main: lm2=", lm2);
    if (lm2 != 0) {
        Class  cls = Class.forName("ExtSyntaxVex");
        Object ins = cls.newInstance();
        Method mr  = cls.getMethod("on_render_line");
        Method mk  = cls.getMethod("on_keypress");
        syntax_ok  = ed.exts.register_handles(cls, ins, mr, mk);
        ed.dlog_i("main: register_handles ExtSyntaxVex syntax_ok=", syntax_ok);
    }

    if (lineno_ok == 1 && syntax_ok == 1) {
        ed.status_msg = "ExtLineNo + ExtSyntaxVex cargadas (F2 toggle | F1 ayuda)";
    } else if (syntax_ok == 1) {
        ed.status_msg = "Solo ExtSyntaxVex cargada (sin gutter)";
    } else if (lineno_ok == 1) {
        ed.status_msg = "Solo ExtLineNo cargada (sin highlighting)";
    } else {
        ed.status_msg = "Ninguna extension cargada";
    }
    ed.dlog("main: status_msg seteado");

    // Si argv tiene un archivo, cargarlo automaticamente.
    i32 ac = args_count();
    ed.dlog_i("main: args_count=", ac);
    if (ac >= 1) {
        string fname = args_get(0);
        ed.load_file(fname);
        ed.dlog("main: load_file done");
    } else {
        // Sin argv: preguntar al usuario por la carpeta del proyecto antes
        // de entrar al loop principal (estilo vnano).  Si el usuario pulsa
        // Enter sin escribir, mantiene el cwd actual.  Esto refresca el
        // sidebar al volver para mostrar la carpeta correcta.
        ed.prompt_project_folder();
        ed.dlog("main: project folder prompt done");
    }

    ed.dlog("main: pre ed.run()");
    // Envoltorio try/catch: con A.34.fix19 (captura de access violations
    // OS-level a FatalError), un crash dentro del editor se convierte en
    // FatalError capturable.  Sin esto, una AV no recuperable mataria
    // todo el proceso; con esto, el editor cierra el log antes de salir.
    try {
        ed.run();
    } catch (FatalError e) {
        ed.dlog_i("main: CAUGHT FatalError kind=", e.kind);
        ed.dlog_i("main: CAUGHT FatalError pc=", e.pc);
    }
    ed.dlog("main: post ed.run()");
    ed.dlog_close();
    return 0;
}
