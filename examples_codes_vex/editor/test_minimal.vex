// Repro minimo: helper recibe (object, string), hace println, luego str_cstr.
// CASO A: orden problematico (println antes de str_cstr)
// CASO B: workaround (capturar str_cstr/str_bytes ANTES de cualquier println)

class Holder {
    public i32 v;
    public Holder() { this.v = 100; }
    public i32 get() { return this.v; }
}

void helper_buggy(Holder h, string s) {
    println("HELPER_BUGGY: entrada con h.v=${h.get()}");
    flush();
    u8* bdat = str_cstr(s);
    i32 len  = str_bytes(s);
    println("HELPER_BUGGY: bdat[0]=${bdat[0]} len=${len}");
    flush();
}

void helper_workaround(Holder h, string s) {
    // Capturar host_ptr y len ANTES del println.
    u8* bdat = str_cstr(s);
    i32 len  = str_bytes(s);
    println("HELPER_OK: entrada con h.v=${h.get()}");
    flush();
    println("HELPER_OK: bdat[0]=${bdat[0]} len=${len}");
    flush();
}

i32 main() {
    Holder h = new Holder();

    println("=== caso A: orden problematico ===");
    flush();
    helper_buggy(h, "hola");
    println("(si llegamos aqui, el caso A no crashe)");
    flush();

    println("=== caso B: workaround ===");
    flush();
    helper_workaround(h, "hola");
    println("(caso B termino OK)");
    return 0;
}
