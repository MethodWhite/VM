// ECS basico (Entity Component System) sobre Vex.
//
// Ejemplo minimal de un patron ECS Struct-of-Arrays (SoA).  Cada componente
// (Position, Velocity) es un par de arrays paralelos; un "sistema" es una
// funcion top-level que itera sobre los arrays y aplica una transformacion.
// Esta forma genera el bytecode mas optimo: solo LOAD/STORE de palabras y
// aritmetica directa, sin indireccion por objeto y maxima localidad de
// cache (todos los pos_x contiguos, todos los pos_y contiguos, etc).
//
// El frontend ya tiene todo lo necesario:
//   - struct value-type
//   - native arrays T[N] / T[] con decay-to-pointer
//   - clases para sistemas con estado
//
// Por simplicidad usamos i32 en vez de f64 (mismo patron, menos ruido).
//
// Resultado esperado: 100
//   - px iniciales: 0,1,2,3,4,5,6,7        (suma 28)
//   - py iniciales: 0,2,4,6,8,10,12,14     (suma 56)
//   - vx = 1, vy = 1 para todas las entidades
//   - tras un tick: px = 1..8 (suma 36), py = 1,3,5,7,9,11,13,15 (suma 64)
//   - total = 36 + 64 = 100

// --- Sistema: actualiza pos += vel para cada entidad activa.
// Recibe los componentes como arrays (decay-to-ptr); n = numero de
// entidades vivas.  Coste por entidad: 4 LOAD + 2 ADD + 2 STORE = 8 ops
// nominales (mas el incremento de bucle).  El optimizer del IR aplica
// copy propagation y constant folding sobre el indice; el CSE de
// direcciones lo hace el back-end al traducir &arr[i] varias veces.
i32 system_movement(i32[] pos_x, i32[] pos_y,
                    i32[] vel_x, i32[] vel_y, i32 n) {
    i32 i = 0;
    while (i < n) {
        pos_x[i] = pos_x[i] + vel_x[i];
        pos_y[i] = pos_y[i] + vel_y[i];
        i = i + 1;
    }
    return 0;
}

// --- Sistema de "rendering" mock: suma todas las posiciones.  En un
// motor real seria un draw call por entidad; aqui solo necesitamos un
// valor agregado para verificar la simulacion.
i32 system_sum_positions(i32[] pos_x, i32[] pos_y, i32 n) {
    i32 s = 0;
    i32 i = 0;
    while (i < n) {
        s = s + pos_x[i] + pos_y[i];
        i = i + 1;
    }
    return s;
}

i32 main() {
    // Componentes en stack (8 entidades).  En un motor real estos
    // arrays vivirian en heap (malloc) y el numero de entidades se
    // gestionaria con un free-list.  Para el demo, stack basta.
    i32[8] pos_x;
    i32[8] pos_y;
    i32[8] vel_x;
    i32[8] vel_y;

    // Inicializacion: pos = (i, 2*i), vel = (1, 1)
    i32 i = 0;
    while (i < 8) {
        pos_x[i] = i;
        pos_y[i] = i + i;
        vel_x[i] = 1;
        vel_y[i] = 1;
        i = i + 1;
    }

    // Tick: ejecutar el sistema una vez.
    system_movement(pos_x, pos_y, vel_x, vel_y, 8);

    // Recolectar resultado para validacion.
    return system_sum_positions(pos_x, pos_y, 8);
}
