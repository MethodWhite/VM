// Diagrama bytecode .vel (Graphviz DOT)
// Cada nodo = un label del .vel (bloque basico).
// Tooltips contienen TODAS las instrucciones (no solo las primeras 10).
// Edges:
//   solid sin label   = jmp incondicional
//   solid con label cc= jmp.cc condicional
//   solid con cmpjmp  = cmpjmp fusionado
//   dotted purpura    = callvm a otra funcion
// Opcodes destacados (cmpjmp/cmpjmpu/decjnz/gcallocp/spawnargs/fulfillhlt)
// llevan borde grueso y color amarillo.
// Render con: dot -Tsvg <archivo>.dot -o <archivo>.svg
digraph VEL {
    rankdir=TB;
    node [fontname="monospace", fontsize=10];
    edge [fontname="sans-serif", fontsize=9];
    graph [fontname="sans-serif", fontsize=12];
