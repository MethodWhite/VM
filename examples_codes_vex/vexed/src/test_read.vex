import "modules/file_io";
import "modules/buffer";

i32 main() {
    file_io.FileReader fr = new file_io.FileReader();
    Result<i64, i32> r = fr.read_all("nonexistent_file.xyz");
    if (isOk(r)) {
        return 42;
    }
    // Esperado: error code 1 (FE_NOT_FOUND)
    // Si bug cross-mem: error code 0
    return 200 + (i32) error(r);
}
