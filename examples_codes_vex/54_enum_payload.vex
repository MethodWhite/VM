// Test de enum con variantes con payload + match destructuring.
//
// Resultado esperado: R0 = 105 (Some(42) -> 42 + Square(7) -> 49 + Sum(7,7) -> 14)

enum Op {
    Nop,
    Square(i32),
    Sum(i32, i32)
}

i32 evaluate(Op op) {
    match op {
        case Nop          => return 0;
        case Square(n)    => return n * n;
        case Sum(a, b)    => return a + b;
    }
    return -1;  // unreachable (match es exhaustive)
}

i32 main() {
    Op a = Op.Square(7);
    Op b = Op.Sum(7, 7);
    return evaluate(a) + evaluate(b) + 42;  // 49 + 14 + 42 = 105
}
