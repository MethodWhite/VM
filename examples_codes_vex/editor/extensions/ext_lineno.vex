// =============================================================================
// extensions/ext_lineno.vex - extension runtime: gutter de numeros de linea
// =============================================================================
//
// Demuestra:
//   - Multi-extension: convive con ExtSyntaxVex en el mismo editor.
//   - Composicion: imprime un prefijo (numero de linea) y devuelve 0
//     para que la siguiente extension (syntax-highlight) continue
//     procesando la linea.
//
// Layout del prefijo: " NNNN | " (5 dig digit + separator).
// Para lineas con NNNN <= 9999 cabe en 5 chars; numeros mayores
// expanden el ancho dinamicamente.

class ExtLineNo {
    public ExtLineNo() { }

    // Devuelve la posicion de la i-esima potencia de 10 menor que n.
    // Equivale a num_digits(n) en decimal.
    public i32 num_digits(i32 n) {
        if (n < 10)        { return 1; }
        if (n < 100)       { return 2; }
        if (n < 1000)      { return 3; }
        if (n < 10000)     { return 4; }
        if (n < 100000)    { return 5; }
        if (n < 1000000)   { return 6; }
        if (n < 10000000)  { return 7; }
        if (n < 100000000) { return 8; }
        return 9;
    }

    // Hook composable: imprime el prefijo " NNNN | " y devuelve 0 para
    // que la siguiente extension (e.g. syntax-highlight) procese el
    // contenido de la linea.
    public i32 on_render_line(i32 line_no, u8* bdat, i32 line_off, i32 line_end, i32 cols) {
        // Padding a la izquierda hasta ancho 5.
        i32 nd = this.num_digits(line_no);
        i32 pad = 0;
        if (nd < 5) { pad = 5 - nd; }
        print(DIM); print(WHITE);
        if (pad > 0) { print_pad(32, pad); }   // 32 = ' ' (espacio)
        print_int(line_no);
        print(" | ");
        print(RESET);
        return 0;  // continuar al siguiente hook (syntax)
    }
}

i32 main() {
    return 1;
}
