// Bench: dispatch polimorfico via interfaz (3 implementaciones).
// Imita patron clasico de "Shape / Circle / Rect / Triangle".
// Devirt NO debe activar (multiple subclases).
// 10M iter alternando entre 3 implementaciones.

interface Shape {
    public i32 area();
}

class Circle : Shape {
    public i32 r;
    public Circle(i32 r) { this.r = r; }
    public i32 area() { return this.r * this.r * 3; }  // ~PI
}

class Rect : Shape {
    public i32 w;
    public i32 h;
    public Rect(i32 w, i32 h) { this.w = w; this.h = h; }
    public i32 area() { return this.w * this.h; }
}

class Triangle : Shape {
    public i32 b;
    public i32 h;
    public Triangle(i32 b, i32 h) { this.b = b; this.h = h; }
    public i32 area() { return (this.b * this.h) / 2; }
}

i32 main() {
    Shape c = new Circle(5);
    Shape r = new Rect(4, 6);
    Shape t = new Triangle(3, 8);

    i32 sum = 0;
    i32 i   = 0;
    while (i < 10000000) {
        // Rotar entre las 3 (polimorfico real).
        i32 mod = i % 3;
        if (mod == 0) sum = sum + c.area();
        else if (mod == 1) sum = sum + r.area();
        else sum = sum + t.area();
        i = i + 1;
    }
    return sum;
}
