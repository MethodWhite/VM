// Regresion vreg (2026-06-09): ALLOCA-vm (struct local cuyo puntero ESCAPA a
// otra funcion -> el frontend NO lo promueve a host_alloca; debe vivir en el
// VM stack con un vaddr valido).  Ejercita el codegen ALLOCA_VM del path vreg
// (mov [rbx+SP]; sub; mov [rbx+SP]) + el save/restore del VM-RSP en el
// prologue/epilogue.  Sin el restore, el VM stack haria leak/overflow entre
// las multiples llamadas del loop.  Esperado: 10 * (3+4) = 70.
struct P { i64 x; i64 y; }

i64 sink(P* p) {
    return (*p).x + (*p).y;   // p es un vaddr (escapo del caller) -> LOAD_VM
}

i64 use() {
    P local;            // ALLOCA-vm: &local escapa a sink()
    local.x = 3;
    local.y = 4;
    return sink(&local);
}

i64 main() {
    i64 acc = 0;
    i64 i = 0;
    while (i < 10) {     // muchas llamadas -> el VM-RSP debe restaurarse en cada RET
        acc = acc + use();
        i = i + 1;
    }
    return acc;
}
