// vexdoc.vex - Vex Documentation Generator
// Usage:
//   vexdoc file.vex               - Generate markdown docs for a single file (stdout)
//   vexdoc --html file.vex -o dir/  - Generate HTML output
//   vexdoc --project src/ -o dir/   - Generate docs for entire project
//   vexdoc --serve dir/             - Start HTTP server to preview docs
//
// Requires: vexdoc.extract, vexdoc.html_gen

// Import submodules
use vexdoc.extract
use vexdoc.html_gen

// -----------------------------------------------------------------
//  CLI argument parsing
// -----------------------------------------------------------------

type CliArgs = struct {
    mode:       string   // "markdown", "html", "project", "serve"
    input:      string   // file or directory path
    output_dir: string   // output directory (for html/project modes)
}

/// Parse command-line arguments
fn parse_args(args: string[]) -> CliArgs {
    let result = CliArgs { mode: "markdown", input: "", output_dir: "./docs" }

    let mut i: i32 = 1  // skip program name (arg[0])
    while i < args.size() {
        let arg = args[i]

        if arg == "--html" {
            result.mode = "html"
        } elif arg == "--project" {
            result.mode = "project"
            i = i + 1
            if i < args.size() { result.input = args[i] }
        } elif arg == "--serve" {
            result.mode = "serve"
            i = i + 1
            if i < args.size() { result.output_dir = args[i] }
        } elif arg == "-o" {
            i = i + 1
            if i < args.size() { result.output_dir = args[i] }
        } elif arg[0] == '-' {
            // Skip unknown flags
        } else {
            // Positional argument: input file or directory
            result.input = arg
        }
        i = i + 1
    }

    return result
}

// -----------------------------------------------------------------
//  Markdown output
// -----------------------------------------------------------------

/// Generate markdown documentation for a single module
fn generate_markdown(mod: extract.ModuleDoc) -> string {
    let mut md: string = ""

    // Title
    md = md ++ "# " ++ mod.namespace ++ "\n\n"
    if mod.description.size() > 0 {
        md = md ++ mod.description ++ "\n\n"
    }
    md = md ++ "**File:** `" ++ mod.file_path ++ "`\n\n"

    // Types
    if mod.types.size() > 0 {
        md = md ++ "## Types\n\n"
        let mut i: i32 = 0
        while i < mod.types.size() {
            let t = mod.types[i]
            md = md ++ "### " ++ t.name ++ " (" ++ t.type_kind ++ ")\n\n"
            if t.doc.text.size() > 0 {
                md = md ++ t.doc.text ++ "\n\n"
            }

            if t.fields.size() > 0 {
                md = md ++ "| Field | Type | Description |\n"
                md = md ++ "|-------|------|-------------|\n"
                let mut j: i32 = 0
                while j < t.fields.size() {
                    let f = t.fields[j]
                    let desc = if f.doc.text.size() > 0 { f.doc.text } else { "" }
                    md = md ++ "| `" ++ f.name ++ "` | `" ++ f.type_name ++ "` | " ++ desc ++ " |\n"
                    j = j + 1
                }
                md = md ++ "\n"
            }
            i = i + 1
        }
    }

    // Functions
    if mod.functions.size() > 0 {
        md = md ++ "## Functions\n\n"
        let mut i: i32 = 0
        while i < mod.functions.size() {
            let f = mod.functions[i]
            md = md ++ "### " ++ f.name ++ "\n\n"
            md = md ++ "```vex\n" ++ f.signature ++ "\n```\n\n"

            if f.doc.text.size() > 0 {
                md = md ++ f.doc.text ++ "\n\n"
            }

            // Parameters
            if f.params.size() > 0 {
                md = md ++ "**Parameters:**\n\n"
                md = md ++ "| Name | Type | Description |\n"
                md = md ++ "|------|------|-------------|\n"
                let mut j: i32 = 0
                while j < f.params.size() {
                    let p = f.params[j]
                    // Find matching @param tag
                    let mut desc: string = ""
                    let mut k: i32 = 0
                    while k < f.doc.tags.size() {
                        if f.doc.tags[k].name == "param" && f.doc.tags[k].key == p.name {
                            desc = f.doc.tags[k].value
                        }
                        k = k + 1
                    }
                    md = md ++ "| `" ++ p.name ++ "` | `" ++ p.type_name ++ "` | " ++ desc ++ " |\n"
                    j = j + 1
                }
                md = md ++ "\n"
            }

            // Return type
            if f.return_type.size() > 0 {
                md = md ++ "**Returns:** `" ++ f.return_type ++ "`"
                let mut j: i32 = 0
                while j < f.doc.tags.size() {
                    if f.doc.tags[j].name == "return" && f.doc.tags[j].value.size() > 0 {
                        md = md ++ " - " ++ f.doc.tags[j].value
                    }
                    j = j + 1
                }
                md = md ++ "\n\n"
            }

            // Tags
            let mut j: i32 = 0
            while j < f.doc.tags.size() {
                let tag = f.doc.tags[j]
                if tag.name == "example" {
                    md = md ++ "**Example:**\n\n```vex\n" ++ tag.value ++ "\n```\n\n"
                }
                if tag.name == "see" {
                    md = md ++ "**See also:** " ++ tag.value ++ "\n\n"
                }
                if tag.name == "deprecated" {
                    let dep_msg = if tag.value.size() > 0 { tag.value } else { "This item is deprecated." }
                    md = md ++ "> **Deprecated:** " ++ dep_msg ++ "\n\n"
                }
                j = j + 1
            }

            i = i + 1
        }
    }

    // Constants
    if mod.constants.size() > 0 {
        md = md ++ "## Constants\n\n"
        let mut i: i32 = 0
        while i < mod.constants.size() {
            md = md ++ "- `" ++ mod.constants[i] ++ "`\n"
            i = i + 1
        }
        md = md ++ "\n"
    }

    return md
}

