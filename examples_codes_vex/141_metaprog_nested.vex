// ComptimeValue recursivo + strings dinamicos.
// Cubre:
//  (1) Arrays de strings comptime
//  (2) Structs anidados con campos no-int (via shared_ptr internamente)
//  (3) Builtins de strings dinamicos: chr/ord/substr/repeat/to_str
//  (4) Construccion textual char-por-char en compile-time

// (1) Array de strings comptime.
comptime string[4] FIELDS = {"x", "y", "z", "w"};
static_assert(comptime_streq(FIELDS[0], "x"),    "f0");
static_assert(comptime_streq(FIELDS[3], "w"),    "f3");
static_assert(comptime_strlen(FIELDS[0]) == 1,   "len 1");

// (3) Strings dinamicos: chr/ord/substr/repeat/to_str.
comptime string LETTER_A = comptime_chr(65);         // "A"
comptime u64    ORD_A    = comptime_ord("A");        // 65
comptime string TAIL     = comptime_substr("HelloWorld", 5, 5);  // "World"
comptime string BARS     = comptime_repeat("|", 8);  // "||||||||"
comptime string NUM_S    = comptime_to_str(2024);    // "2024"

static_assert(comptime_streq(LETTER_A, "A"),         "chr 65");
static_assert(ORD_A == 65,                           "ord A");
static_assert(comptime_streq(TAIL, "World"),         "substr");
static_assert(comptime_strlen(BARS) == 8,            "repeat | x8");
static_assert(comptime_streq(NUM_S, "2024"),         "to_str");

// (4) Generic textual: construir un identificador a partir de un tipo.
comptime <T> string mk_setter_name() {
    return comptime_concat("set_", typename<T>());
}

struct Vec3 { f64 x; f64 y; f64 z; }
comptime string SETTER_V3 = mk_setter_name<Vec3>();
static_assert(comptime_streq(SETTER_V3, "set_Vec3"), "setter Vec3");

// (4) Comptime fn iterativa que construye string de A..N.
comptime string alphabet_up_to(i64 n) {
    comptime var string buf = "";
    comptime var i64 c = 65;
    while (c <= n) {
        buf = comptime_concat(buf, comptime_chr(c));
        c = c + 1;
    }
    return buf;
}

comptime string ABCDEF = alphabet_up_to(70);
static_assert(comptime_streq(ABCDEF, "ABCDEF"), "alphabet A..F");
static_assert(comptime_strlen(ABCDEF) == 6,     "len 6");

// (4) Build CSV-style separator string en compile-time.
comptime string CSV_HEADER =
    comptime_concat(
        comptime_concat(FIELDS[0],
            comptime_concat(",", FIELDS[1])),
        comptime_concat(",",
            comptime_concat(FIELDS[2],
                comptime_concat(",", FIELDS[3]))));

static_assert(comptime_streq(CSV_HEADER, "x,y,z,w"), "csv header");

i32 main() {
    // Use comptime strings at runtime: they materialize.
    string lbl = SETTER_V3;
    i32 ok = 0;
    if (lbl.length() == 8) ok = ok + 21;
    if (ABCDEF.length() == 6) ok = ok + 21;
    return ok;  // 42
}
