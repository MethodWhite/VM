// Benchmark de callvirt: 30M llamadas a metodo virtual trivial.
class Counter {
    public i32 value;
    public Counter() { this.value = 0; }
    public i32 inc() { return 1; }
}

i32 main() {
    Counter c = new Counter();
    i32 i = 0;
    i32 sum = 0;
    while (i < 30000000) {
        sum = sum + c.inc();
        i = i + 1;
    }
    return sum;
}
