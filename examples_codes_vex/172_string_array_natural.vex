// examples_codes_vex/172_string_array_natural.vex
//
// Sintaxis C-style natural para arrays de bytes + char literals.
//
// Demuestra:
//   - `u8[N] msg = "literal"` inicializa el array con los bytes del
//     string (zerifica el padding restante).  Sin promocion a
//     StringObject; el array es memoria contigua cruda.
//   - `arr[i] = 'X'` acepta char literal (CHAR <-> integral coercion).
//   - `vio_print_buf(host_ptr, len)` para emisar bytes crudos.
//
// Esperado: R00 = 42, output a stdout:
//   "Hola Vex!\n
//    -> bytes modificados: HOLA VEX!\n
//    -> codepoints: 65 76"

extern "stdlib/native/io/vesta_io" {
    fn vio_print_buf(u8* buf, u64 len) -> i64;
}

i32 main() {
    // (1) Init C-style: array de 16 u8 con literal de 10 bytes; los 6
    //     restantes quedan a 0 (semantica C clasica).
    u8[16] msg = "Hola Vex!\n";
    vio_print_buf(&msg[0], 10);

    // (2) Mutacion in-place con char literals.  Convertimos a mayusculas
    //     los chars alfabeticos (A-Z = a-z - 32).
    i32 i = 0;
    while (i < 10) {
        u8 c = msg[i];
        if (c >= 'a' && c <= 'z') {
            msg[i] = c - 32;  // a..z -> A..Z (i32 - 32 -> u8 trunca)
        }
        i = i + 1;
    }
    print("-> bytes modificados: ");
    vio_print_buf(&msg[0], 10);

    // (3) Verificar codepoints individuales.
    u8 first = msg[0];   // 'H' = 72
    u8 last  = msg[8];   // '!' = 33
    println("-> codepoints: ${first} ${last}");

    // (4) Validar.
    i32 acc = 0;
    if (msg[0] == 'H') { acc = acc + 10; }   // 'H' = 72
    if (msg[5] == 'V') { acc = acc + 10; }   // 'V' = 86
    if (msg[9] == '\n') { acc = acc + 10; }  // '\n' = 10
    if (first == 72 && last == 33) { acc = acc + 12; }
    return acc;  // 10+10+10+12 = 42
}
