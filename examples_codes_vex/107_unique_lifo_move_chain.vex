// Test exhaustivo: multiples unique<T> en mismo scope + cleanup LIFO + move chain.
//
// Verificamos:
//   1. Tres unique<T> en mismo scope se liberan en orden inverso de creacion
//      (LIFO): C creado ultimo, liberado primero; A creado primero, liberado
//      ultimo.
//   2. Move chain (a -> b -> c): tras los moves, solo c posee el valor;
//      a y b tienen slot=0 y su cleanup es no-op.
//
// Estructura: cada deleter Vesta registra el valor que recibe en un array
// global (via static field).  Al final verificamos:
//   - 3 valores registrados (no leak ni double-free).
//   - Orden de liberacion: LIFO.

class Trace {
    public static i64 idx;
    public static i64 v0;
    public static i64 v1;
    public static i64 v2;
}

void record_release(i64 v) {
    if (Trace.idx == 0) {
        Trace.v0 = v;
    } else if (Trace.idx == 1) {
        Trace.v1 = v;
    } else if (Trace.idx == 2) {
        Trace.v2 = v;
    }
    Trace.idx = Trace.idx + 1;
}

// Test 1: 3 unique<i64> en scope, distintos valores; orden LIFO esperado.
void test_lifo() {
    unique<i64> a = unique_with(100, record_release);
    unique<i64> b = unique_with(200, record_release);
    unique<i64> c = unique_with(300, record_release);
    // Al RET: cleanup LIFO -> record(300), record(200), record(100).
}

// Test 2: move chain.  Tras los moves, solo el destino final libera.
void test_move() {
    unique<i64> a = unique_with(999, record_release);
    unique<i64> b = move(a);    // a queda con slot=0; b tiene 999.
    unique<i64> c = move(b);    // b queda con slot=0; c tiene 999.
    // Al RET: cleanup en orden LIFO (c, b, a).  Solo c tiene valor:
    //   record(999) (de c)
    //   record(0)   (de b, slot=0)  -> el cleanup llama deleter con 0
    //   record(0)   (de a, slot=0)  -> idem
    //
    // NOTA: el deleter recibe el VALUE almacenado en el slot.  Si el
    // user quiere null-safety, debe chequear `if (p == 0)` en su deleter.
    // En este test no tenemos null-check para verificar el comportamiento
    // exacto.
}

i32 main() {
    // Reset.
    Trace.idx = 0;
    Trace.v0  = 0;
    Trace.v1  = 0;
    Trace.v2  = 0;

    test_lifo();

    // Verificamos orden LIFO esperado: 300, 200, 100.
    if (Trace.idx != 3) {
        return 100 + Trace.idx;
    }
    if (Trace.v0 != 300) {
        return 200 + Trace.v0;
    }
    if (Trace.v1 != 200) {
        return 300 + Trace.v1;
    }
    if (Trace.v2 != 100) {
        return 400 + Trace.v2;
    }

    return 42;
}
