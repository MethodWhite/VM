// =============================================================================
// VEXED - Editor de codigo TUI escrito en Vex (v2 - buffer dinamico + atajos
// vnano-compatibles + syntax highlighter integrado)
// =============================================================================
//
// Editor TUI compatible con los atajos de vnano.vsh.  Caracteristicas:
//
//   * Buffer dinamico (LinkedList<Line>) - sin limite de lineas.
//   * Syntax highlighter Vex integrado (modules/syntax_vex.vh).
//   * FFI runtime (msvcrt + user32) para input no-bloqueante + GetAsyncKeyState.
//   * Atajos vnano-compatibles: Ctrl+Q salir, Ctrl+S guardar, Ctrl+K cortar
//     linea, Ctrl+G goto line, Ctrl+H ayuda, F1 ayuda, F2 toggle highlighter.
//   * Movimiento por palabra (Ctrl+L/R), por linea (Home/End), por pagina
//     (PgUp/PgDn).
//   * Cursor logico/visual sincronizado.
//   * Status bar con linea/columna/dirty.
//
// Caracteristicas del lenguaje Vex usadas:
//   * FFI runtime (ffi_open / ffi_sym / ffi_call)
//   * Clases con destructores recursivos (RAII)
//   * String + interpolacion ${...} + operadores
//   * ANSI codes magicos (RED, GREEN, BOLD, ...)
//   * Punteros raw + malloc/free
//
// USO: vm --vex vexed.vex -o vexed && vm --run vexed.velb
//
// LIMITACIONES CONOCIDAS (deferidas):
//   * Sin pestanas multiples (vnano lo tiene; aqui MVP single-buffer).
//   * Sin sidebar / FileTree.
//   * Sin multicursor / Shift+arrows.
//   * Sin Cut/Copy/Paste con clipboard externo (Ctrl+K cuts a clipboard interno).
//   * Sin Undo/Redo.
//   * Sin autocompletar.

#include "modules/syntax_vex.vh"

// =============================================================================
// SECCION 1: Constantes de teclas (compatibles con vnano)
// =============================================================================
//
// Codigos ASCII directos para Ctrl+Letra (vnano usa los mismos).  Codigos
// negativos para teclas extendidas (BIOS scancode 0x00/0xE0 + scancode).

const i32 KEY_NONE        = -1;
// Ctrl+letra (ASCII 1..26)
const i32 KEY_CTRL_A      = 1;
const i32 KEY_CTRL_B      = 2;
const i32 KEY_CTRL_C      = 3;
const i32 KEY_CTRL_D      = 4;
const i32 KEY_CTRL_E      = 5;
const i32 KEY_CTRL_F      = 6;
const i32 KEY_CTRL_G      = 7;
const i32 KEY_BS          = 8;     // Ctrl+H tambien = ASCII 8 (mismo conflicto que vnano)
const i32 KEY_TAB         = 9;
const i32 KEY_ENTER       = 13;
const i32 KEY_CTRL_K      = 11;
const i32 KEY_CTRL_L      = 12;
const i32 KEY_CTRL_N      = 14;
const i32 KEY_CTRL_O      = 15;
const i32 KEY_CTRL_Q      = 17;
const i32 KEY_CTRL_R      = 18;
const i32 KEY_CTRL_S      = 19;
const i32 KEY_CTRL_T      = 20;
const i32 KEY_CTRL_U      = 21;
const i32 KEY_CTRL_V      = 22;
const i32 KEY_CTRL_W      = 23;
const i32 KEY_CTRL_X      = 24;
const i32 KEY_CTRL_Y      = 25;
const i32 KEY_CTRL_Z      = 26;
const i32 KEY_ESC         = 27;
const i32 KEY_DELETE      = 127;
// Teclas extendidas
const i32 KEY_UP          = -1000;
const i32 KEY_DOWN        = -1001;
const i32 KEY_LEFT        = -1002;
const i32 KEY_RIGHT       = -1003;
const i32 KEY_HOME        = -1004;
const i32 KEY_END         = -1005;
const i32 KEY_PGUP        = -1006;
const i32 KEY_PGDN        = -1007;
const i32 KEY_DEL         = -1008;
const i32 KEY_F1          = -1100;
const i32 KEY_F2          = -1101;
const i32 KEY_F3          = -1102;
const i32 KEY_F4          = -1103;
const i32 KEY_F5          = -1104;
const i32 KEY_F6          = -1105;
const i32 KEY_F7          = -1106;
const i32 KEY_F8          = -1107;
const i32 KEY_F9          = -1108;
const i32 KEY_F10         = -1109;
// Ctrl + flechas (scancode 0xE0 + 0x73/0x74 etc en Windows)
const i32 KEY_CTRL_LEFT   = -3000;
const i32 KEY_CTRL_RIGHT  = -3001;
const i32 KEY_CTRL_UP     = -3002;
const i32 KEY_CTRL_DOWN   = -3003;

// =============================================================================
// SECCION 2: InputBackend - lectura de teclas via FFI
// =============================================================================

class InputBackend {
    public i64 lib_msvcrt;
    public i64 lib_user32;
    public i64 lib_kernel32;
    public i64 sym_kbhit;
    public i64 sym_getch;
    public i64 sym_gaks;
    public i64 sym_get_console_mode;
    public i64 sym_set_console_mode;
    public i64 sym_get_std_handle;
    public i64 saved_console_mode;       // para restaurar al exit
    public i64 stdin_handle;

    public InputBackend() {
        this.lib_msvcrt  = ffi_open("msvcrt.dll");
        this.lib_user32  = ffi_open("user32.dll");
        this.lib_kernel32 = ffi_open("kernel32.dll");
        this.sym_kbhit   = ffi_sym(this.lib_msvcrt, "_kbhit");
        this.sym_getch   = ffi_sym(this.lib_msvcrt, "_getch");
        this.sym_gaks    = 0;
        this.stdin_handle = 0;
        this.saved_console_mode = 0;
        if (this.lib_user32 != 0) {
            this.sym_gaks = ffi_sym(this.lib_user32, "GetAsyncKeyState");
        }
        // Console raw mode: deshabilitar ENABLE_PROCESSED_INPUT (intercepta
        // Ctrl+C/Ctrl+S como signals/XOFF) y ENABLE_LINE_INPUT (no esperar Enter).
        // Sin esto Ctrl+S puede pausar la salida o ser comido por la consola.
        if (this.lib_kernel32 != 0) {
            this.sym_get_std_handle  = ffi_sym(this.lib_kernel32, "GetStdHandle");
            this.sym_get_console_mode = ffi_sym(this.lib_kernel32, "GetConsoleMode");
            this.sym_set_console_mode = ffi_sym(this.lib_kernel32, "SetConsoleMode");
            this.enable_raw_mode();
        }
    }

    // Llama GetStdHandle(STD_INPUT_HANDLE = -10) y SetConsoleMode con flags
    // que evitan que la consola intercepte Ctrl+C/Ctrl+S antes de _getch.
    public void enable_raw_mode() {
        // STD_INPUT_HANDLE = -10 (sign-extended 0xFFFFFFFFFFFFFFF6)
        i64 hstd = ffi_call(this.sym_get_std_handle, -10);
        if (hstd == 0) { return; }
        this.stdin_handle = hstd;
        // Reservar 4 bytes para el modo actual (DWORD).
        u8* mode_buf = malloc(8);
        mode_buf[0] = 0; mode_buf[1] = 0; mode_buf[2] = 0; mode_buf[3] = 0;
        i64 ok = ffi_call(this.sym_get_console_mode, hstd, mode_buf);
        if (ok == 0) { free(mode_buf); return; }
        i32 m0 = mode_buf[0]; i32 m1 = mode_buf[1];
        i32 m2 = mode_buf[2]; i32 m3 = mode_buf[3];
        i32 cur_mode = m0 + (m1 * 256) + (m2 * 65536) + (m3 * 16777216);
        this.saved_console_mode = cur_mode;
        // Quitar ENABLE_LINE_INPUT (0x0002), ENABLE_ECHO_INPUT (0x0004),
        // ENABLE_PROCESSED_INPUT (0x0001).  Mantener ENABLE_EXTENDED_FLAGS
        // (0x0080) para que SetConsoleMode acepte estos cambios.
        i32 new_mode = (cur_mode & 0xFFFFFFF8) | 0x0080;
        ffi_call(this.sym_set_console_mode, hstd, new_mode);
        free(mode_buf);
    }

    public void restore_console_mode() {
        if (this.stdin_handle != 0 && this.saved_console_mode != 0) {
            ffi_call(this.sym_set_console_mode, this.stdin_handle, this.saved_console_mode);
        }
    }

    public i32 poll_key() {
        i64 n = ffi_call(this.sym_kbhit);
        if (n == 0) { return KEY_NONE; }
        i64 c = ffi_call(this.sym_getch);
        if (c == 0 || c == 224) {
            i64 c2 = ffi_call(this.sym_getch);
            return this.win_special(c2);
        }
        i32 ic = c;
        return ic;
    }

    public i32 read_key_blocking() {
        flush();
        while (true) {
            i32 k = this.poll_key();
            if (k != KEY_NONE) { return k; }
        }
        return KEY_NONE;
    }

    // Mapeo de scancodes Windows extendidos.  Tomado de vnano._win_special.
    public i32 win_special(i64 c2) {
        if (c2 == 72)  { return KEY_UP;    }
        if (c2 == 80)  { return KEY_DOWN;  }
        if (c2 == 75)  { return KEY_LEFT;  }
        if (c2 == 77)  { return KEY_RIGHT; }
        if (c2 == 71)  { return KEY_HOME;  }
        if (c2 == 79)  { return KEY_END;   }
        if (c2 == 73)  { return KEY_PGUP;  }
        if (c2 == 81)  { return KEY_PGDN;  }
        if (c2 == 83)  { return KEY_DEL;   }
        if (c2 == 59)  { return KEY_F1;    }
        if (c2 == 60)  { return KEY_F2;    }
        if (c2 == 61)  { return KEY_F3;    }
        if (c2 == 62)  { return KEY_F4;    }
        if (c2 == 63)  { return KEY_F5;    }
        if (c2 == 64)  { return KEY_F6;    }
        if (c2 == 65)  { return KEY_F7;    }
        if (c2 == 66)  { return KEY_F8;    }
        if (c2 == 67)  { return KEY_F9;    }
        if (c2 == 68)  { return KEY_F10;   }
        if (c2 == 115) { return KEY_CTRL_LEFT;  }
        if (c2 == 116) { return KEY_CTRL_RIGHT; }
        if (c2 == 141) { return KEY_CTRL_UP;    }
        if (c2 == 145) { return KEY_CTRL_DOWN;  }
        return KEY_NONE;
    }

    public i32 is_key_down(i32 vkey) {
        if (this.sym_gaks == 0) { return 0; }
        i64 r = ffi_call(this.sym_gaks, vkey);
        if ((r & 0x8000) != 0) { return 1; }
        return 0;
    }
}

// =============================================================================
// SECCION 3: Screen - render TUI con ANSI
// =============================================================================

class Screen {
    public i32 cols;
    public i32 rows;

    public Screen() {
        this.cols = 100;
        this.rows = 30;
    }

    public void clear() {
        print(CLEAR_SCREEN);
        print(CURSOR_HOME);
    }

    public void move_cursor(i32 row, i32 col) {
        print("\x1b[${row};${col}H");
    }

    public void hide_cursor() { print("\x1b[?25l"); }
    public void show_cursor() { print("\x1b[?25h"); }
}

// =============================================================================
// SECCION 4: Line - linea de texto con buffer raw + sigueinte (LinkedList)
// =============================================================================

class Line {
    public u8* data;
    public i32  length;
    public i32  capacity;
    public Line next;

    public Line() {
        this.capacity = 64;
        this.data = malloc(64);
        this.length = 0;
        this.data[0] = 0;
        this.next = null;
    }

    public ~Line() {
        if (this.data != null) { free(this.data); }
    }

    public void ensure_capacity(i32 need) {
        if (need + 1 <= this.capacity) { return; }
        i32 new_cap = this.capacity;
        while (new_cap < need + 1) { new_cap = new_cap * 2; }
        u8* nbuf = malloc(new_cap);
        i32 i = 0;
        while (i < this.length) { nbuf[i] = this.data[i]; i = i + 1; }
        nbuf[this.length] = 0;
        free(this.data);
        this.data = nbuf;
        this.capacity = new_cap;
    }

    public void insert_char(i32 pos, i32 c) {
        if (pos < 0) { pos = 0; }
        if (pos > this.length) { pos = this.length; }
        this.ensure_capacity(this.length + 1);
        i32 i = this.length;
        while (i > pos) { this.data[i] = this.data[i - 1]; i = i - 1; }
        this.data[pos] = c;
        this.length = this.length + 1;
        this.data[this.length] = 0;
    }

    public void delete_char(i32 pos) {
        if (pos < 0 || pos >= this.length) { return; }
        i32 i = pos;
        while (i < this.length - 1) { this.data[i] = this.data[i + 1]; i = i + 1; }
        this.length = this.length - 1;
        this.data[this.length] = 0;
    }

    public void append_char(i32 c) { this.insert_char(this.length, c); }

    // Devuelve true si data[pos] es alfanumerico o '_' (para movimiento por palabra).
    public i32 is_word_char(i32 pos) {
        if (pos < 0 || pos >= this.length) { return 0; }
        i32 c = this.data[pos];
        if (c >= 65 && c <= 90)  { return 1; }       // A-Z
        if (c >= 97 && c <= 122) { return 1; }       // a-z
        if (c >= 48 && c <= 57)  { return 1; }       // 0-9
        if (c == 95)              { return 1; }       // _
        return 0;
    }
}

// =============================================================================
// SECCION 5: Buffer - lista enlazada de lineas + cursor + dirty flag
// =============================================================================

class Buffer {
    public Line head;
    public i32  line_count;
    public i32  cursor_row;
    public i32  cursor_col;
    public i32  dirty;          // 1 si modificado desde ultimo guardado
    public i32  scroll_top;     // primera linea visible

    public Buffer() {
        this.head = new Line();
        this.line_count = 1;
        this.cursor_row = 0;
        this.cursor_col = 0;
        this.dirty = 0;
        this.scroll_top = 0;
    }

    public Line get_line(i32 idx) {
        if (idx < 0) { return null; }
        Line cur = this.head;
        i32 i = 0;
        while (cur != null && i < idx) {
            cur = cur.next;
            i = i + 1;
        }
        return cur;
    }

    public Line current_line() { return this.get_line(this.cursor_row); }

    public void insert_char(i32 c) {
        Line l = this.current_line();
        if (l == null) { return; }
        l.insert_char(this.cursor_col, c);
        this.cursor_col = this.cursor_col + 1;
        this.dirty = 1;
    }

    public void backspace() {
        Line l = this.current_line();
        if (l == null) { return; }
        if (this.cursor_col > 0) {
            l.delete_char(this.cursor_col - 1);
            this.cursor_col = this.cursor_col - 1;
            this.dirty = 1;
        } else {
            // Cursor en col 0 -> fusionar con linea anterior si existe.
            if (this.cursor_row > 0) {
                Line prev = this.get_line(this.cursor_row - 1);
                if (prev != null) {
                    i32 new_col = prev.length;
                    // Copiar contenido de l a prev.
                    i32 i = 0;
                    while (i < l.length) {
                        prev.append_char(l.data[i]);
                        i = i + 1;
                    }
                    // Desenlazar l.
                    prev.next = l.next;
                    l.next = null;
                    this.line_count = this.line_count - 1;
                    this.cursor_row = this.cursor_row - 1;
                    this.cursor_col = new_col;
                    this.dirty = 1;
                }
            }
        }
    }

    public void delete_forward() {
        Line l = this.current_line();
        if (l == null) { return; }
        if (this.cursor_col < l.length) {
            l.delete_char(this.cursor_col);
            this.dirty = 1;
        } else {
            // Cursor al final de la linea -> fusionar con siguiente.
            if (l.next != null) {
                Line next = l.next;
                i32 i = 0;
                while (i < next.length) {
                    l.append_char(next.data[i]);
                    i = i + 1;
                }
                l.next = next.next;
                next.next = null;
                this.line_count = this.line_count - 1;
                this.dirty = 1;
            }
        }
    }

    public void newline() {
        Line l = this.current_line();
        if (l == null) { return; }
        // Crear nueva linea con el contenido despues del cursor.
        Line nl = new Line();
        i32 i = this.cursor_col;
        while (i < l.length) {
            nl.append_char(l.data[i]);
            i = i + 1;
        }
        // Truncar la linea actual al cursor.
        l.length = this.cursor_col;
        l.data[l.length] = 0;
        // Insertar nl despues de l.
        nl.next = l.next;
        l.next = nl;
        this.line_count = this.line_count + 1;
        this.cursor_row = this.cursor_row + 1;
        this.cursor_col = 0;
        this.dirty = 1;
    }

    // Movimiento basico.
    public void move_left() {
        if (this.cursor_col > 0) {
            this.cursor_col = this.cursor_col - 1;
        } else if (this.cursor_row > 0) {
            this.cursor_row = this.cursor_row - 1;
            Line l = this.current_line();
            if (l != null) { this.cursor_col = l.length; }
        }
    }

    public void move_right() {
        Line l = this.current_line();
        if (l == null) { return; }
        if (this.cursor_col < l.length) {
            this.cursor_col = this.cursor_col + 1;
        } else if (this.cursor_row < this.line_count - 1) {
            this.cursor_row = this.cursor_row + 1;
            this.cursor_col = 0;
        }
    }

    public void move_up() {
        if (this.cursor_row > 0) {
            this.cursor_row = this.cursor_row - 1;
            Line l = this.current_line();
            if (l != null && this.cursor_col > l.length) {
                this.cursor_col = l.length;
            }
        }
    }

    public void move_down() {
        if (this.cursor_row < this.line_count - 1) {
            this.cursor_row = this.cursor_row + 1;
            Line l = this.current_line();
            if (l != null && this.cursor_col > l.length) {
                this.cursor_col = l.length;
            }
        }
    }

    public void move_home() { this.cursor_col = 0; }
    public void move_end()  {
        Line l = this.current_line();
        if (l != null) { this.cursor_col = l.length; }
    }

    public void move_pgup(i32 page) {
        i32 n = this.cursor_row - page;
        if (n < 0) { n = 0; }
        this.cursor_row = n;
        Line l = this.current_line();
        if (l != null && this.cursor_col > l.length) { this.cursor_col = l.length; }
    }

    public void move_pgdn(i32 page) {
        i32 n = this.cursor_row + page;
        if (n >= this.line_count) { n = this.line_count - 1; }
        this.cursor_row = n;
        Line l = this.current_line();
        if (l != null && this.cursor_col > l.length) { this.cursor_col = l.length; }
    }

    // Ctrl+L: salto de palabra a izquierda.  Skip non-word-chars y luego skip
    // word-chars hasta encontrar el inicio de la palabra anterior.
    public void move_word_left() {
        if (this.cursor_col == 0 && this.cursor_row > 0) {
            this.move_left();
            return;
        }
        Line l = this.current_line();
        if (l == null) { return; }
        i32 c = this.cursor_col - 1;
        // Skip hacia atras los no-word-chars.
        while (c > 0 && l.is_word_char(c) == 0) { c = c - 1; }
        // Skip hacia atras los word-chars.
        while (c > 0 && l.is_word_char(c - 1) == 1) { c = c - 1; }
        this.cursor_col = c;
    }

    // Ctrl+R: salto de palabra a derecha (vnano usa Ctrl+R en su wordmap).
    public void move_word_right() {
        Line l = this.current_line();
        if (l == null) { return; }
        i32 c = this.cursor_col;
        // Skip hacia adelante los word-chars.
        while (c < l.length && l.is_word_char(c) == 1) { c = c + 1; }
        // Skip hacia adelante los no-word-chars.
        while (c < l.length && l.is_word_char(c) == 0) { c = c + 1; }
        this.cursor_col = c;
        if (c == l.length && this.cursor_row < this.line_count - 1) {
            this.cursor_row = this.cursor_row + 1;
            this.cursor_col = 0;
        }
    }

    // Ctrl+K: cortar la linea actual al portapapeles interno (Editor mantiene).
    // Devuelve un puntero al buffer copiado (caller debe liberar) y len.
    public u8* cut_line(VirtualPtr<i32> out_len) {
        Line l = this.current_line();
        if (l == null) { *out_len = 0; return null; }
        // Copia del contenido.
        u8* copy = malloc(l.length + 1);
        i32 i = 0;
        while (i < l.length) { copy[i] = l.data[i]; i = i + 1; }
        copy[l.length] = 0;
        *out_len = l.length;
        // Eliminar la linea (similar a backspace+delete_forward combinados).
        if (this.line_count > 1) {
            // Si es la primera linea, head pasa a head.next.
            if (this.cursor_row == 0) {
                Line old_head = this.head;
                this.head = this.head.next;
                old_head.next = null;
                this.line_count = this.line_count - 1;
                if (this.cursor_row >= this.line_count) {
                    this.cursor_row = this.line_count - 1;
                }
            } else {
                Line prev = this.get_line(this.cursor_row - 1);
                if (prev != null) {
                    Line dead = prev.next;
                    prev.next = dead.next;
                    dead.next = null;
                    this.line_count = this.line_count - 1;
                    if (this.cursor_row >= this.line_count) {
                        this.cursor_row = this.line_count - 1;
                    }
                }
            }
        } else {
            // Solo queda 1 linea -> vaciarla.
            l.length = 0;
            l.data[0] = 0;
        }
        this.cursor_col = 0;
        this.dirty = 1;
        return copy;
    }

    // Ctrl+U / Ctrl+V: pegar buffer.  Inserta cada caracter en la posicion actual.
    public void paste(u8* src, i32 len) {
        if (src == null || len <= 0) { return; }
        i32 i = 0;
        while (i < len) {
            i32 c = src[i];
            if (c == 10) { this.newline(); }
            else { this.insert_char(c); }
            i = i + 1;
        }
        this.dirty = 1;
    }

    // Cargar texto inicial separado por '\n'.
    public void load_text(u8* data, i32 len) {
        i32 i = 0;
        while (i < len) {
            i32 c = data[i];
            if (c == 10) { this.newline(); }
            else if (c == 13) { /* skip CR */ }
            else { this.insert_char(c); }
            i = i + 1;
        }
        this.cursor_row = 0;
        this.cursor_col = 0;
        this.dirty = 0;
    }

    // Guardar al fichero `path` via FFI a msvcrt.
    public i32 save_to_file(string path) {
        i64 lib = ffi_open("msvcrt.dll");
        if (lib == 0) { return 0; }
        i64 sym_fopen  = ffi_sym(lib, "fopen");
        i64 sym_fwrite = ffi_sym(lib, "fwrite");
        i64 sym_fclose = ffi_sym(lib, "fclose");
        // A.34.fix7 - str_cstr("literal") ya promociona el literal a
        // StringObject (mismo patron que A.34.fix3 para args de funciones
        // top-level).  Pasar literales directamente funciona ahora.
        i64 fp = ffi_call(sym_fopen, str_cstr(path), str_cstr("wb"));
        if (fp == 0) { return 0; }
        u8* nl = malloc(1);
        nl[0] = 10;
        Line cur = this.head;
        while (cur != null) {
            if (cur.length > 0) {
                ffi_call(sym_fwrite, cur.data, 1, cur.length, fp);
            }
            ffi_call(sym_fwrite, nl, 1, 1, fp);
            cur = cur.next;
        }
        free(nl);
        ffi_call(sym_fclose, fp);
        this.dirty = 0;
        return 1;
    }
}

// =============================================================================
// SECCION 6: Editor - orquestador con TUI + handlers de teclas
// =============================================================================

class Editor {
    public InputBackend input;
    public Screen       screen;
    public Buffer       buffer;
    public SyntaxVex    sv;
    public string       filename;
    public string       status_msg;
    public i32          running;
    public i32          last_key;
    public i32          save_count;
    public i32          show_help;          // 1 = overlay de ayuda visible
    public i32          highlighter_on;     // 1 = colorear con sv, 0 = plano

    // Clipboard interno (cut buffer).  Asignado por cut_line, liberado al
    // proximo cut o al destructor.
    public u8*  clip_data;
    public i32  clip_len;

    public Editor() {
        this.input          = new InputBackend();
        this.screen         = new Screen();
        this.buffer         = new Buffer();
        this.sv             = new SyntaxVex();
        // Filename vacio: el primer save_file disparara el prompt.
        this.filename       = "";
        this.status_msg     = "[scratch - Ctrl+Q salir, Ctrl+O/F4 guardar (pide nombre), F1 ayuda]";
        this.running        = 1;
        this.last_key       = 0;
        this.save_count     = 0;
        this.show_help      = 0;
        this.highlighter_on = 1;
        this.clip_data      = null;
        this.clip_len       = 0;
    }

    public ~Editor() {
        if (this.clip_data != null) { free(this.clip_data); }
    }

    // Prompt en la status bar: pide texto hasta Enter, devuelve el resultado
    // como string.  Esc cancela y devuelve "".  Estilo nano "Write Out As".
    public string prompt(string label) {
        // Buffer raw para acumular caracteres tipeados.
        u8* buf = malloc(256);
        i32 len = 0;
        buf[0] = 0;

        i32 done = 0;
        i32 cancelled = 0;
        while (done == 0) {
            // Render del prompt en la status bar.
            this.screen.move_cursor(this.screen.rows, 1);
            print(REVERSE);
            print(label);
            // Imprimir lo tipeado hasta ahora.
            i32 i = 0;
            while (i < len) { print_char(buf[i]); i = i + 1; }
            print("_");           // cursor visual
            print("\x1b[K");
            print(RESET);
            flush();

            i32 k = this.input.read_key_blocking();
            if (k == KEY_ENTER) { done = 1; }
            else if (k == KEY_ESC) { done = 1; cancelled = 1; }
            else if (k == KEY_BS) {
                if (len > 0) { len = len - 1; buf[len] = 0; }
            } else if (k >= 32 && k <= 126 && len < 250) {
                buf[len] = k;
                len = len + 1;
                buf[len] = 0;
            }
            // Otras teclas (flechas, Ctrl+...) se ignoran en el prompt.
        }

        if (cancelled == 1) {
            free(buf);
            string empty = "";
            return empty;
        }
        // Convertir buf a StringObject via str_make (builtin que crea una
        // string desde un host_ptr + len).
        string result = str_make(buf, len);
        free(buf);
        return result;
    }

    // Guarda al fichero actual.  Si el filename esta vacio o el usuario
    // pidio "save as" (Ctrl+W estilo nano), pregunta el nombre.
    public void save_file() {
        // Si filename es "vexed_out.txt" (default) o vacio, preguntar.
        string default_name = "vexed_out.txt";
        i32 needs_prompt = 0;
        if (str_equals(this.filename, default_name)) { needs_prompt = 1; }
        if (str_length(this.filename) == 0) { needs_prompt = 1; }
        if (needs_prompt == 1) {
            string label = "Guardar como: ";
            string nf = this.prompt(label);
            if (str_length(nf) == 0) {
                this.status_msg = "[guardar cancelado]";
                return;
            }
            this.filename = nf;
        }
        i32 ok = this.buffer.save_to_file(this.filename);
        if (ok == 1) {
            this.save_count = this.save_count + 1;
            this.status_msg = "[guardado en ${this.filename} (${this.save_count}x)]";
        } else {
            this.status_msg = "[error al guardar ${this.filename}]";
        }
    }

    // Ctrl+W: guardar como (forzar prompt incluso si filename esta seteado).
    public void save_file_as() {
        string label = "Guardar como: ";
        string nf = this.prompt(label);
        if (str_length(nf) == 0) {
            this.status_msg = "[guardar cancelado]";
            return;
        }
        this.filename = nf;
        i32 ok = this.buffer.save_to_file(this.filename);
        if (ok == 1) {
            this.save_count = this.save_count + 1;
            this.status_msg = "[guardado en ${this.filename} (${this.save_count}x)]";
        } else {
            this.status_msg = "[error al guardar ${this.filename}]";
        }
    }

    public void cut_current_line() {
        if (this.clip_data != null) { free(this.clip_data); this.clip_data = null; }
        i32 len = 0;
        u8* data = this.buffer.cut_line(&len);
        this.clip_data = data;
        this.clip_len  = len;
        this.status_msg = "[cortada linea (${len} bytes)]";
    }

    public void paste_clipboard() {
        if (this.clip_data == null || this.clip_len == 0) {
            this.status_msg = "[clipboard vacio]";
            return;
        }
        this.buffer.paste(this.clip_data, this.clip_len);
        this.buffer.newline();      // pegar siempre crea nueva linea (estilo nano Ctrl+U)
        this.status_msg = "[pegadas ${this.clip_len} bytes]";
    }

    // ----- Render -----

    // Cabecera: titulo + nombre del fichero + dirty marker.
    public void render_header() {
        this.screen.move_cursor(1, 1);
        print(BOLD); print(CYAN); print("VEXED  ");
        print(RESET); print(YELLOW);
        print("Ctrl+Q salir  Ctrl+O/F4 guardar  Ctrl+W/F5 guardar como  F1 ayuda ");
        print(RESET);
        if (this.buffer.dirty == 1) { print(RED); print("[modificado]"); print(RESET); }
        print("\x1b[K");
    }

    // Render del buffer: itera lineas visibles, llama al highlighter o
    // imprime plano segun this.highlighter_on.
    public void render_buffer() {
        i32 visible = this.screen.rows - 3;       // header + status + 1 margen
        i32 first   = this.buffer.scroll_top;
        i32 i       = 0;
        Line cur = this.buffer.get_line(first);
        while (i < visible && cur != null) {
            this.screen.move_cursor(i + 2, 1);
            if (cur.length > 0) {
                if (this.highlighter_on == 1) {
                    this.sv.render_line(cur.data, 0, cur.length, this.screen.cols);
                } else {
                    print_cstr(cur.data);
                }
            }
            print("\x1b[K");
            cur = cur.next;
            i = i + 1;
        }
        // Lineas vacias hasta el final con tilde estilo nano/vim.
        while (i < visible) {
            this.screen.move_cursor(i + 2, 1);
            print(DIM); print("~"); print(RESET);
            print("\x1b[K");
            i = i + 1;
        }
    }

    public void render_status() {
        this.screen.move_cursor(this.screen.rows, 1);
        print(REVERSE);
        if (str_length(this.filename) == 0) {
            print(" [sin nombre]  ");
        } else {
            print(" ${this.filename}  ");
        }
        print("L${this.buffer.cursor_row + 1}:C${this.buffer.cursor_col + 1}");
        print("  lineas=${this.buffer.line_count}");
        print("  ${this.status_msg}");
        print("\x1b[K");
        print(RESET);
    }

    // Overlay de ayuda (Ctrl+H / F1).  Pinta una caja centrada con los atajos.
    public void render_help() {
        if (this.show_help == 0) { return; }
        i32 row = 4;
        this.screen.move_cursor(row, 8); print(REVERSE);
        print(" === VEXED - AYUDA (Esc cierra) === ");
        print(RESET);
        row = row + 2;
        this.screen.move_cursor(row, 8); print("SALIR / GUARDAR (atajos duales por compat Windows console):"); row = row + 1;
        this.screen.move_cursor(row, 8); print("  Ctrl+Q          salir");                                        row = row + 1;
        this.screen.move_cursor(row, 8); print("  Ctrl+S, Ctrl+O, F4   guardar (Ctrl+S puede ser XOFF en cmd)"); row = row + 2;
        this.screen.move_cursor(row, 8); print("EDICION:");                                                       row = row + 1;
        this.screen.move_cursor(row, 8); print("  Ctrl+K          cortar linea");                                 row = row + 1;
        this.screen.move_cursor(row, 8); print("  Ctrl+V, Ctrl+U  pegar");                                        row = row + 1;
        this.screen.move_cursor(row, 8); print("  Backspace, Del  borrar (con merge de lineas)");                 row = row + 1;
        this.screen.move_cursor(row, 8); print("  Tab             4 espacios");                                   row = row + 2;
        this.screen.move_cursor(row, 8); print("MOVIMIENTO:");                                                    row = row + 1;
        this.screen.move_cursor(row, 8); print("  Flechas         basico                Home/End  inicio/fin");   row = row + 1;
        this.screen.move_cursor(row, 8); print("  Ctrl+L, Ctrl+Left   palabra anterior  PgUp/PgDn pagina");       row = row + 1;
        this.screen.move_cursor(row, 8); print("  Ctrl+R, Ctrl+Right  palabra siguiente");                        row = row + 2;
        this.screen.move_cursor(row, 8); print("VISTA:");                                                         row = row + 1;
        this.screen.move_cursor(row, 8); print("  F1   esta ayuda                F2   toggle highlighter");       row = row + 1;
        this.screen.move_cursor(row, 8); print("  Esc  cerrar ayuda");                                            row = row + 1;
    }

    // Posicionar cursor logico -> visual (offset por scroll y header).
    public void place_cursor() {
        i32 visual_row = this.buffer.cursor_row - this.buffer.scroll_top + 2;
        i32 visual_col = this.buffer.cursor_col + 1;
        if (visual_row < 2) { visual_row = 2; }
        this.screen.move_cursor(visual_row, visual_col);
    }

    // Auto-scroll: ajusta scroll_top para que el cursor sea visible.
    public void auto_scroll() {
        i32 visible = this.screen.rows - 3;
        if (this.buffer.cursor_row < this.buffer.scroll_top) {
            this.buffer.scroll_top = this.buffer.cursor_row;
        }
        if (this.buffer.cursor_row >= this.buffer.scroll_top + visible) {
            this.buffer.scroll_top = this.buffer.cursor_row - visible + 1;
        }
        if (this.buffer.scroll_top < 0) { this.buffer.scroll_top = 0; }
    }

    public void render() {
        this.auto_scroll();
        this.screen.hide_cursor();
        this.render_header();
        this.render_buffer();
        this.render_status();
        this.render_help();
        this.place_cursor();
        this.screen.show_cursor();
        flush();
    }

    // ----- Dispatch de teclas -----

    public void handle_key(i32 k) {
        this.last_key = k;
        // Si la ayuda esta abierta, solo Esc la cierra.
        if (this.show_help == 1) {
            if (k == KEY_ESC) {
                this.show_help = 0;
                this.status_msg = "[ayuda cerrada]";
            }
            return;
        }

        if (k == KEY_CTRL_Q) { this.running = 0;          return; }
        // Ctrl+S guarda; Ctrl+O alias clasico (nano-style) y F4 alias visual
        // siempre disponible por si la consola Windows intercepta Ctrl+S
        // como XOFF (aun habiendo desabilitado ENABLE_PROCESSED_INPUT).
        if (k == KEY_CTRL_S) { this.save_file();          return; }
        if (k == KEY_CTRL_O) { this.save_file();          return; }
        if (k == KEY_F4)     { this.save_file();          return; }
        // Ctrl+W (estilo nano "Write Out As") + F5: forzar prompt de filename.
        if (k == KEY_CTRL_W) { this.save_file_as();       return; }
        if (k == KEY_F5)     { this.save_file_as();       return; }
        if (k == KEY_F1)     { this.show_help = 1;        return; }
        if (k == KEY_F2)     {
            if (this.highlighter_on == 1) {
                this.highlighter_on = 0;
                this.status_msg = "[highlighter OFF]";
            } else {
                this.highlighter_on = 1;
                this.status_msg = "[highlighter ON]";
            }
            return;
        }
        // Ctrl+H tiene conflicto con backspace (ASCII 8).  Como vnano,
        // interpretamos ASCII 8 como BACKSPACE (mas frecuente).  Para help,
        // usar F1.

        // Ctrl+K: cortar linea (estilo nano kill-line)
        if (k == KEY_CTRL_K) { this.cut_current_line();   return; }
        // Ctrl+V / Ctrl+U: pegar.  Ctrl+U es el alias clasico de nano para
        // "uncut" (paste); algunas terminales Windows interceptan Ctrl+V
        // como paste del portapapeles del sistema antes de llegar a _getch.
        // Si Ctrl+V no llega, usar Ctrl+U.
        if (k == KEY_CTRL_V || k == KEY_CTRL_U) { this.paste_clipboard(); return; }

        // Movimiento basico
        if (k == KEY_LEFT)   { this.buffer.move_left();   return; }
        if (k == KEY_RIGHT)  { this.buffer.move_right();  return; }
        if (k == KEY_UP)     { this.buffer.move_up();     return; }
        if (k == KEY_DOWN)   { this.buffer.move_down();   return; }
        if (k == KEY_HOME)   { this.buffer.move_home();   return; }
        if (k == KEY_END)    { this.buffer.move_end();    return; }
        if (k == KEY_PGUP)   {
            this.buffer.move_pgup(this.screen.rows - 3);
            return;
        }
        if (k == KEY_PGDN)   {
            this.buffer.move_pgdn(this.screen.rows - 3);
            return;
        }
        if (k == KEY_DEL)    { this.buffer.delete_forward(); return; }

        // Ctrl + flechas: movimiento por palabra (Ctrl+L y Ctrl+R tambien por
        // compat vnano).
        if (k == KEY_CTRL_L || k == KEY_CTRL_LEFT)  { this.buffer.move_word_left();  return; }
        if (k == KEY_CTRL_R || k == KEY_CTRL_RIGHT) { this.buffer.move_word_right(); return; }

        // Edicion basica
        if (k == KEY_ENTER) { this.buffer.newline();   return; }
        if (k == KEY_BS)    { this.buffer.backspace(); return; }
        if (k == KEY_TAB)   {
            // Tab inserta 4 espacios (estilo Vex).
            this.buffer.insert_char(32);
            this.buffer.insert_char(32);
            this.buffer.insert_char(32);
            this.buffer.insert_char(32);
            return;
        }

        // ASCII imprimible
        if (k >= 32 && k <= 126) {
            this.buffer.insert_char(k);
            return;
        }
    }

    public void run() {
        this.screen.clear();
        this.render();
        while (this.running == 1) {
            i32 k = this.input.read_key_blocking();
            this.handle_key(k);
            this.render();
        }
        this.screen.clear();
        this.screen.show_cursor();
        // Restaurar modo de consola original (re-habilita ENABLE_PROCESSED_INPUT
        // etc) para que la shell siga funcionando normal.
        this.input.restore_console_mode();
        print("Hasta luego desde VEXED.\n");
        flush();
    }
}

// =============================================================================
// SECCION 7: main
// =============================================================================

i32 main() {
    Editor ed = new Editor();
    ed.run();
    return 0;
}
