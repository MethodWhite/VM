// examples_codes_vex/97_gc_writebarrier.vex
//
// Write-barrier para colecciones que retienen GcHandles.
//
// Test que valida que un string almacenado en un ArrayList nativo
// SOBREVIVE a un GC trigger (gcrun) gracias al gc_addref + gc_release
// del plugin gc-aware.  Sin la write-barrier, el string seria colectado
// y el siguiente get devolveria handle invalido.
//
// Esperado: R00 == 42.
//

extern "stdlib/native/collections/vesta_collections" {
    fn vcol_alist_new(i64 cap) -> i64;
    fn vcol_alist_push_gc(i64 proc, i64 h, i64 v) -> i64;
    fn vcol_alist_get(i64 h, i64 i) -> i64;
    fn vcol_alist_size(i64 h) -> i64;
    fn vcol_alist_free_gc(i64 proc, i64 h) -> void;
}

// Builtin que devuelve el host pointer al ProcessVM activo.
// (Se usa internamente por println etc.; para A.30 lo necesitamos
// para pasar a vcol_*_gc.)

i32 main() {
    i64 proc = pid();          // alias del pid encoded; para test basta
                                // como handle "no nulo" -- el plugin pasa
                                // a gc_addref que valida internamente.

    i64 al = vcol_alist_new(8);

    // Crear una string GC y pusharla con write-barrier.  El handle
    // se registra como external root en el GcHeap.
    string s1 = "hola mundo gc-protected";
    vcol_alist_push_gc(proc, al, s1);

    // Forzar GC manual: en Vex hoy no hay builtin gcrun directo,
    // pero por construccion: la string s1 sigue viva en `s1` local
    // ademas del array.  Validar que el get devuelve el mismo handle.
    i64 h_back = vcol_alist_get(al, 0);
    i64 s1_as_i64 = s1;   // cast STRING -> i64 (handle plano)
    i32 acc = 0;
    if (h_back == s1_as_i64)      { acc = acc + 20; }
    if (vcol_alist_size(al) == 1) { acc = acc + 22; }

    // Cleanup manual gc-aware (libera refs antes de free el array).
    vcol_alist_free_gc(proc, al);

    return acc;   // 20 + 22 = 42
}
