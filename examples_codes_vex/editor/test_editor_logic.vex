// =============================================================================
// test_editor_logic.vex - validacion no-interactiva del editor modular
// =============================================================================
//
// Instancia un Editor sin entrar al ciclo run() y ejercita directamente
// las operaciones de su modelo: buffer edit, undo/redo, seleccion, tabs.
// Cada bloque imprime PASS/FAIL y cuenta los aciertos.  No depende de
// teclado ni de las extensiones runtime.

#include "modules/keys.vh"
#include "modules/input_backend.vh"
#include "modules/screen.vh"
#include "modules/file_io.vh"
#include "modules/buffer.vh"
#include "modules/extension_api.vh"
#include "modules/file_explorer.vh"
#include "modules/config.vh"
#include "modules/sidebar.vh"
#include "modules/editor_core.vh"

void check(string label, bool cond, VirtualPtr<i32> pass, VirtualPtr<i32> fail) {
    if (cond) {
        print(GREEN); print("  PASS "); print(RESET); println(label);
        *pass = *pass + 1;
    } else {
        print(RED);   print("  FAIL "); print(RESET); println(label);
        *fail = *fail + 1;
    }
    flush();
}

// Compara los bytes [0..len) de buf con los de needle (string literal del test).
bool buf_equals_str(u8* buf, i32 len, string s) {
    i32 sl = str_bytes(s);
    if (sl != len) { return false; }
    u8* sd = str_cstr(s);
    i32 i = 0;
    while (i < len) {
        if (buf[i] != sd[i]) { return false; }
        i = i + 1;
    }
    return true;
}

i32 main() {
    println("");
    println("=== test_editor_logic ===");
    println("");
    i32 pass = 0;
    i32 fail = 0;

    Editor ed = new Editor();

    // -----------------------------------------------------------------
    println("[1] Buffer basico");
    // -----------------------------------------------------------------
    ed.buffer.insert_char(72);   // H
    ed.buffer.insert_char(105);  // i
    check("inserta 2 chars -> length=2",
          ed.buffer.length == 2, &pass, &fail);
    check("contenido = 'Hi'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "Hi"), &pass, &fail);
    check("cursor avanza a 2",
          ed.buffer.cursor == 2, &pass, &fail);

    // -----------------------------------------------------------------
    println("[2] Undo/Redo");
    // -----------------------------------------------------------------
    ed.push_undo();
    ed.buffer.insert_char(33);  // !
    check("post-insert '!' length=3",
          ed.buffer.length == 3, &pass, &fail);
    check("contenido = 'Hi!'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "Hi!"), &pass, &fail);

    ed.cmd_undo();
    check("undo -> length=2",
          ed.buffer.length == 2, &pass, &fail);
    print("  [debug] post-undo bytes:");
    print_int(ed.buffer.data[0]); print(" "); print_int(ed.buffer.data[1]); println("");
    flush();
    check("undo -> contenido = 'Hi'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "Hi"), &pass, &fail);

    ed.cmd_redo();
    check("redo -> length=3",
          ed.buffer.length == 3, &pass, &fail);
    check("redo -> contenido = 'Hi!'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "Hi!"), &pass, &fail);

    // -----------------------------------------------------------------
    println("[3] Seleccion + copy/cut/paste");
    // -----------------------------------------------------------------
    // Estado: buffer = "Hi!", cursor=3.
    // Seleccionar "Hi" (offsets 0..2).
    ed.buffer.cursor = 0;
    ed.sel_begin_or_extend();          // anchor=0
    ed.buffer.cursor = 2;
    check("has_selection() == 1",
          ed.has_selection() == 1, &pass, &fail);
    check("sel_lo=0",
          ed.sel_lo() == 0, &pass, &fail);
    check("sel_hi=2",
          ed.sel_hi() == 2, &pass, &fail);

    ed.sel_copy();
    check("clipboard='Hi' tras sel_copy",
          str_equals(ed.clipboard, "Hi"), &pass, &fail);
    check("buffer intacto post-copy length=3",
          ed.buffer.length == 3, &pass, &fail);

    // Cut.
    ed.push_undo();
    ed.sel_cut();
    check("sel_cut -> length=1",
          ed.buffer.length == 1, &pass, &fail);
    check("sel_cut -> contenido = '!'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "!"), &pass, &fail);
    check("sel_cut limpia anchor",
          ed.sel_anchor == -1, &pass, &fail);

    // Paste.
    ed.push_undo();
    ed.buffer.cursor = 0;
    ed.cmd_paste();
    // cmd_paste inserta clipboard ("Hi") y un newline.  Verificamos que
    // el contenido empieza por "Hi".
    check("post-paste length>=3",
          ed.buffer.length >= 3, &pass, &fail);
    check("post-paste empieza con 'Hi'",
          ed.buffer.data[0] == 72 && ed.buffer.data[1] == 105, &pass, &fail);

    // -----------------------------------------------------------------
    println("[4] Tabs");
    // -----------------------------------------------------------------
    check("inicio: tab_count=1",
          ed.tab_count == 1, &pass, &fail);
    Tab first_tab = ed.tab_active;

    ed.cmd_new_tab();
    check("cmd_new_tab -> tab_count=2",
          ed.tab_count == 2, &pass, &fail);
    check("tab_active != tab_inicial",
          ed.tab_active != first_tab, &pass, &fail);
    check("nuevo tab tiene buffer vacio",
          ed.buffer.length == 0, &pass, &fail);

    // Insertar texto en tab 2.
    ed.buffer.insert_char(65);  // A
    ed.buffer.insert_char(66);  // B
    check("tab 2: contenido = 'AB'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "AB"), &pass, &fail);

    // Volver al tab 1.
    ed.cmd_prev_tab();
    check("cmd_prev_tab vuelve al tab original",
          ed.tab_active == first_tab, &pass, &fail);
    check("tab 1 conserva su contenido (empieza con 'Hi')",
          ed.buffer.length >= 2 && ed.buffer.data[0] == 72 && ed.buffer.data[1] == 105, &pass, &fail);

    // Avanzar a tab 2.
    ed.cmd_next_tab();
    check("cmd_next_tab -> tab 2",
          ed.tab_active != first_tab, &pass, &fail);
    check("tab 2 conserva 'AB'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "AB"), &pass, &fail);

    // Cerrar tab 2 (no esta dirty porque el flag se reset entre push_undo).
    // Forzar dirty=0 antes para evitar el aviso.
    ed.buffer.dirty = 0;
    ed.cmd_close_tab();
    check("cmd_close_tab -> tab_count=1",
          ed.tab_count == 1, &pass, &fail);
    check("post-close vuelve a tab original",
          ed.tab_active == first_tab, &pass, &fail);

    // -----------------------------------------------------------------
    println("[5] Word movement");
    // -----------------------------------------------------------------
    // Construir buffer "hello world" en el tab activo (limpiar primero).
    ed.buffer.length = 0;
    ed.buffer.cursor = 0;
    string sample = "hello world foo";
    i32 sl = str_bytes(sample);
    u8* sd = str_cstr(sample);
    i32 i = 0;
    while (i < sl) {
        ed.buffer.insert_char(sd[i]);
        i = i + 1;
    }
    check("buffer = 'hello world foo'",
          buf_equals_str(ed.buffer.data, ed.buffer.length, "hello world foo"), &pass, &fail);

    // Cursor al inicio.
    ed.buffer.cursor = 0;
    ed.cmd_word_right();
    check("word_right desde 0 -> cursor en 'world' (col 6)",
          ed.buffer.cursor == 6, &pass, &fail);
    ed.cmd_word_right();
    check("word_right -> cursor en 'foo' (col 12)",
          ed.buffer.cursor == 12, &pass, &fail);
    ed.cmd_word_left();
    check("word_left -> cursor en 'world' (col 6)",
          ed.buffer.cursor == 6, &pass, &fail);

    // -----------------------------------------------------------------
    println("[6] Goto line");
    // -----------------------------------------------------------------
    // Construir buffer con 3 lineas.
    ed.buffer.length = 0;
    ed.buffer.cursor = 0;
    string lines = "linea1\nlinea2\nlinea3";
    i32 ll = str_bytes(lines);
    u8* ld = str_cstr(lines);
    i = 0;
    while (i < ll) {
        ed.buffer.insert_char(ld[i]);
        i = i + 1;
    }
    check("line_count = 3",
          ed.buffer.line_count() == 3, &pass, &fail);
    ed.buffer.goto_row_col(1, 0);   // ir a linea 2 (0-based)
    check("goto linea 2 -> cursor_row()=1",
          ed.buffer.cursor_row() == 1, &pass, &fail);

    // -----------------------------------------------------------------
    println("[7] Search (find_substring)");
    // -----------------------------------------------------------------
    string needle = "linea2";
    u8* nd = str_cstr(needle);
    i32 nl = str_bytes(needle);
    i32 found = ed.find_substring(ed.buffer.data, 0, ed.buffer.length, nd, nl);
    check("find_substring('linea2') >= 0",
          found >= 0, &pass, &fail);
    check("offset encontrado = 7 (tras 'linea1\\n')",
          found == 7, &pass, &fail);

    string missing = "no_existe";
    u8* md = str_cstr(missing);
    i32 ml = str_bytes(missing);
    i32 not_found = ed.find_substring(ed.buffer.data, 0, ed.buffer.length, md, ml);
    check("find_substring('no_existe') == -1",
          not_found == -1, &pass, &fail);

    // -----------------------------------------------------------------
    println("[8] FileExplorer.list_current_dir");
    // -----------------------------------------------------------------
    DirEntry entries = ed.fexp.list_current_dir();
    check("list_current_dir devuelve >0 entries",
          entries != null, &pass, &fail);
    i32 count = 0;
    DirEntry p = entries;
    while (p != null) { count = count + 1; p = p.next; }
    check("count >= 3 (al menos build.vsh, modules, vexed_modular.vex)",
          count >= 3, &pass, &fail);

    bool has_main = false;
    p = entries;
    while (p != null) {
        if (str_equals(p.name, "vexed_modular.vex")) { has_main = true; }
        p = p.next;
    }
    check("encuentra 'vexed_modular.vex' en directory listing",
          has_main, &pass, &fail);

    // -----------------------------------------------------------------
    println("");
    println("=== RESUMEN ===");
    print(GREEN); print("PASS: "); print_int(pass); print(RESET); println("");
    print(RED);   print("FAIL: "); print_int(fail); print(RESET); println("");

    if (fail == 0) {
        print(GREEN); println("ALL TESTS PASS"); print(RESET);
        return 0;
    }
    print(RED); println("SOME TESTS FAILED"); print(RESET);
    return 1;
}
