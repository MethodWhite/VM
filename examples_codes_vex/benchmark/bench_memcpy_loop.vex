// Bench: copia secuencial byte-a-byte de un buffer grande.
// Mide throughput de LOAD/STORE de bytes en memoria host (malloc).
// Sin cache misses (1 MB cabe en L2/L3); cuello: latencia de LOAD/STORE
// + branch del loop.
//
// Workload: 1 MB x 100 iteraciones = 100 MB de bytes movidos.

i32 main() {
    u64 N = 1048576;  // 1 MB
    u8* src = (u8*) malloc(N);
    u8* dst = (u8*) malloc(N);

    // Inicializar src con patron predecible.
    u64 i = 0;
    while (i < N) {
        src[i] = (u8)(i & 0xFF);
        i = i + 1;
    }

    // Hot path: 100 iteraciones del memcpy manual.
    i64 iter = 0;
    while (iter < 100) {
        u64 j = 0;
        while (j < N) {
            dst[j] = src[j];
            j = j + 1;
        }
        iter = iter + 1;
    }

    // Verificacion: leer un byte para que el compilador no elimine la copia.
    i32 r = (i32) dst[1234];
    free(src);
    free(dst);
    return r;  // esperado: 1234 & 0xFF = 0xD2 = 210
}
