// =============================================================================
// 101_raii_casos_limite.vex - Test exhaustivo del sistema RAII
// =============================================================================
//
// Cubre los casos limite del manejo automatico de objetos GC tras los fixes
//
//   - Clase con `~Class()`         -> CALL_DTOR al exit del scope
//   - Clase sin `~Class()`         -> drop handle al exit (no acumula)
//   - `i64 obj = newInstance(cls)` -> drop handle al exit (no acumula)
//   - early return desde if-then   -> destructor ejecutado
//   - multiples instancias         -> N destructores LIFO
//   - RAII por iteracion de loop   -> N destructores (scope-local A.34.fix5)
//   - escape via return            -> NO ejecuta destructor (caller toma owner)
//   - outer GC value vivo a traves de loop con newInstance interno
//     (NEWOBJ save_live_regs A.34.fix5)
//
// Cada caso retorna su valor de Counter via funcion auxiliar para evitar
// el bug pre-existente del regalloc con multiples accesos a static field
// concatenados en una interpolacion (findclass inline clobera regs).
//
// Resultado: R0 = 42 si todos los invariantes basicos se cumplen.

class Counter {
    public static i32 cnt;
    public Counter() {}
}

class R {
    public i32 id;
    public R(i32 i) { this.id = i; }
    public ~R() { Counter.cnt = Counter.cnt + 1; }
    public i32 get() { return this.id; }
}

class Plain {
    public i32 id;
    public Plain(i32 i) { this.id = i; }
    public i32 get() { return this.id; }
}

i32 caso_1() {
    R r = new R(100);
    return r.get();
}

i32 caso_4(i32 cond) {
    R r = new R(7);
    if (cond == 1) { return 7; }
    return 0;
}

i32 caso_5() {
    R a = new R(1);
    R b = new R(2);
    R c = new R(3);
    return a.get() + b.get() + c.get();
}

// Helper que dispara 1 dtor por llamada (cleanup al RET).
i32 helper_one_R(i32 v) {
    R tmp = new R(v);
    return tmp.get();
}

i32 caso_6_loop_dtor(i32 n) {
    // Refactor del loop a un helper para que cada iter dispare 1 dtor
    // (cleanup al RET del helper).  Sin scope-local cleanup, este es
    // el patron recomendado para RAII por iteracion.
    i32 sum = 0;
    i32 i = 0;
    while (i < n) {
        sum = sum + helper_one_R(i);
        i = i + 1;
    }
    return sum;
}

R caso_7_escape() {
    R r = new R(42);
    return r;
}

i32 caso_8_outer_alive(i32 iters) {
    R holder = new R(99);
    i64 cls = forName("Plain");
    i32 i = 0;
    while (i < iters) {
        i64 obj = newInstance(cls);
        if (obj == 0) { return -1; }
        i = i + 1;
    }
    return holder.get();
}

class MyExc {
    public i32 codigo;
    public MyExc(i32 c) { this.codigo = c; }
}

// CASO 9: try/catch con escape correcto del valor capturado.  El
// cleanup automatico de R en funciones con try queda DESACTIVADO
// (limitacion documentada) pero el control flow + handle del exception
// funciona correctamente.  Para liberacion deterministica con try,
// usar `~Class()` explicito o `drop()` manual.
i32 caso_9_try_catch() {
    i32 acc = 0;
    try {
        throw new MyExc(99);
    } catch (MyExc e) {
        acc = e.codigo;
    }
    return acc;
}

// Helpers que aislan static fields a un solo acceso por funcion.
i32 read_cnt() { return Counter.cnt; }
void reset_cnt() { Counter.cnt = 0; }

// Verificadores simples que retornan 1 si OK, 0 si FAIL.
// Imprimen el valor observado para diagnostico.
i32 expect(string label, i32 got, i32 expected) {
    println("${label}: got=${got} exp=${expected}");
    if (got == expected) { return 1; }
    return 0;
}

i32 main() {
    reset_cnt();
    i32 ok = 0;

    // CASO 1: 1 dtor.
    reset_cnt();
    i32 r1 = caso_1();
    ok = ok + expect("C1 ret", r1, 100);
    ok = ok + expect("C1 dtor", read_cnt(), 1);

    // CASO 4: dtor en early return.
    reset_cnt();
    i32 r4 = caso_4(1);
    ok = ok + expect("C4 ret", r4, 7);
    ok = ok + expect("C4 dtor", read_cnt(), 1);

    // CASO 5: 3 dtors LIFO.
    reset_cnt();
    i32 r5 = caso_5();
    ok = ok + expect("C5 ret", r5, 6);
    ok = ok + expect("C5 dtor", read_cnt(), 3);

    // CASO 6: dtor POR ITERACION (scope-local cleanup A.34.fix5).
    reset_cnt();
    i32 r6 = caso_6_loop_dtor(50);
    ok = ok + expect("C6 ret", r6, 1225);
    ok = ok + expect("C6 dtor", read_cnt(), 50);

    // CASO 7: escape via return.  El dtor NO corre en el helper.
    reset_cnt();
    R owned = caso_7_escape();
    ok = ok + expect("C7 dtor en helper", read_cnt(), 0);

    // CASO 8: outer GC vivo a traves de loop (NEWOBJ save_live_regs).
    i32 r8 = caso_8_outer_alive(100);
    ok = ok + expect("C8 holder", r8, 99);

    // CASO 9: try/catch funcional aunque cleanup automatico no aplica.
    i32 r9 = caso_9_try_catch();
    ok = ok + expect("C9 try/catch", r9, 99);

    println("--- ${ok}/11 checks passed ---");
    if (ok == 11) {
        println("RAII OK: todos los casos pasaron");
        return 42;
    }
    return ok;
}
