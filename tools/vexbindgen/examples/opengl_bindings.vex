    @Extern("opengl32:glViewport")
    fn glViewport(x: i32, y: i32, width: i32, height: i32)

    @Extern("opengl32:glScissor")
    fn glScissor(x: i32, y: i32, width: i32, height: i32)

    @Extern("opengl32:glEnable")
    fn glEnable(cap: u32)

    @Extern("opengl32:glDisable")
    fn glDisable(cap: u32)

    @Extern("opengl32:glGetError")
    fn glGetError() -> u32

    // --- Shader program ---

    @Extern("opengl32:glCreateShader")
    fn glCreateShader(shader_type: u32) -> u32

