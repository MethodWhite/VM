// examples_codes_vex/94_escape_detection.vex
//
// Escape detection: si el handle de una coleccion se devuelve
// (return), no se aplica el cleanup automatico al exit del scope.  El
// caller toma posesion y debera liberar (o el GC root cuando este wired).
//
// Sin escape detection: la funcion `make_list` registraria cleanup que
// liberaria xs justo antes del return -> el caller recibe handle dangling
// -> el primer get/size en el caller crashea o devuelve garbage.
//
// Con escape detection: el cleanup NO se emite, el caller recibe el
// handle valido, y el caller (`main`) lo libera via dispose o cleanup
// del scope.
//
// Esperado: R00 == 42.

ArrayList make_list() {
    ArrayList xs = arraylist(8);
    xs.push(10);
    xs.push(20);
    xs.push(12);
    return xs;   // xs escapa: NO auto-free aqui.
}

i32 main() {
    ArrayList result = make_list();
    // result tiene los 3 elementos pushed dentro de make_list.
    i64 sum = result.get(0) + result.get(1) + result.get(2);
    i32 r = sum;   // 10 + 20 + 12 = 42
    // Al exit de main, el cleanup automatico libera result.
    return r;
}
