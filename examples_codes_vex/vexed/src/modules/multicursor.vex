// =============================================================================
// modules/multicursor.vex - cursores secundarios para editor multi-cursor
// =============================================================================
//
// Mantiene un array de posiciones extras (byte offsets dentro del buffer).
// El cursor PRIMARIO sigue siendo b.cursor.  Las posiciones extras son
// independientes y se aplican en paralelo a operaciones de insert/delete.
//
// Convencion: cuando hay >=1 extra, ESC limpia todos.  Char/Backspace/Delete
// aplican en orden REVERSE (mayor offset primero) para que las posiciones
// menores no se invaliden al modificar el buffer.
//
// Para mantenerlo simple, los movimientos individuales (left/right/up/down)
// SOLO mueven el cursor primario; las extras se mantienen estaticas hasta
// que se aplique una operacion de edicion o se limpien con ESC.

import "modules/buffer";

public comptime i32 MC_MAX = 16;

public class MultiCursor {
    public i32* offsets;
    public i32  count;

    public MultiCursor() {
        this.offsets = malloc(MC_MAX * 4);
        this.count   = 0;
    }

    public i32 has_extras() {
        if (this.count > 0) return 1;
        return 0;
    }

    public void clear() {
        this.count = 0;
    }

    // Devuelve la columna (offset desde inicio de linea) de `pos`.
    public i32 col_of(buffer.Buffer b, i32 pos) {
        i32 col = 0;
        i32 i = pos - 1;
        while (i >= 0) {
            if (b.data[i] == 10) return col;
            col = col + 1;
            i = i - 1;
        }
        return col;
    }

    // Encuentra el offset de inicio de la linea N (0-based).
    public i32 line_start_of(buffer.Buffer b, i32 row) {
        if (row == 0) return 0;
        i32 cur = 0;
        i32 i = 0;
        while (i < b.length) {
            if (b.data[i] == 10) {
                cur = cur + 1;
                if (cur == row) return i + 1;
            }
            i = i + 1;
        }
        return b.length;
    }

    // Encuentra el offset de fin de la linea que contiene `pos` (sin contar \n).
    public i32 line_end_of(buffer.Buffer b, i32 pos) {
        i32 i = pos;
        while (i < b.length && b.data[i] != 10) i = i + 1;
        return i;
    }

    // Agrega un cursor extra una linea ARRIBA de b.cursor, misma columna
    // (truncada a la longitud de la linea destino).  Si ya estamos en la
    // primera linea, no hace nada.
    public void add_above(buffer.Buffer b) {
        if (this.count >= MC_MAX) return;
        i32 row = b.cursor_row();
        if (row == 0) return;
        i32 col = this.col_of(b, b.cursor);
        i32 target_row = row - 1;
        i32 ls = this.line_start_of(b, target_row);
        i32 le = this.line_end_of(b, ls);
        i32 line_len = le - ls;
        i32 new_off = ls + col;
        if (new_off > le) new_off = le;
        // Verificar que no este ya en el array.
        i32 j = 0;
        while (j < this.count) {
            if (this.offsets[j] == new_off) return;
            j = j + 1;
        }
        this.offsets[this.count] = new_off;
        this.count = this.count + 1;
    }

    // Agrega un cursor extra una linea ABAJO.
    public void add_below(buffer.Buffer b) {
        if (this.count >= MC_MAX) return;
        i32 row = b.cursor_row();
        i32 total = b.line_count();
        if (row >= total - 1) return;
        i32 col = this.col_of(b, b.cursor);
        i32 target_row = row + 1;
        i32 ls = this.line_start_of(b, target_row);
        i32 le = this.line_end_of(b, ls);
        i32 new_off = ls + col;
        if (new_off > le) new_off = le;
        i32 j = 0;
        while (j < this.count) {
            if (this.offsets[j] == new_off) return;
            j = j + 1;
        }
        this.offsets[this.count] = new_off;
        this.count = this.count + 1;
    }

    // Ordena `offsets` descendente para que insertion/deletion aplique de
    // mayor a menor (preservando los offsets menores).
    public void sort_desc() {
        i32 i = 0;
        while (i < this.count) {
            i32 j = i + 1;
            while (j < this.count) {
                if (this.offsets[j] > this.offsets[i]) {
                    i32 tmp = this.offsets[i];
                    this.offsets[i] = this.offsets[j];
                    this.offsets[j] = tmp;
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    // Inserta `c` en TODOS los cursores (primario + extras).  Devuelve cuantos
    // se aplicaron.  Tras esto, ajusta extras + primario por el shift.
    public i32 insert_char_at_all(buffer.Buffer b, i32 c) {
        if (this.count == 0) {
            b.insert_char(c);
            return 1;
        }
        // Construir lista combinada: primary + extras, sort desc.
        i32* all = malloc((MC_MAX + 1) * 4);
        i32 n = 0;
        all[n] = b.cursor; n = n + 1;
        i32 j = 0;
        while (j < this.count) { all[n] = this.offsets[j]; n = n + 1; j = j + 1; }
        // Bubble sort desc (n <= 17, ok).
        i32 a = 0;
        while (a < n) {
            i32 bb = a + 1;
            while (bb < n) {
                if (all[bb] > all[a]) {
                    i32 t = all[a]; all[a] = all[bb]; all[bb] = t;
                }
                bb = bb + 1;
            }
            a = a + 1;
        }
        // Aplicar insertion en cada (de mayor a menor).
        i32 k = 0;
        while (k < n) {
            b.cursor = all[k];
            b.insert_char(c);
            k = k + 1;
        }
        // Recalcular extras: cada extra cuyo offset > offset original del
        // primario se shiftea +1 por cada insertion ANTES de el.  Como
        // aplicamos desc, los offsets pre-insertion mas pequenos quedan
        // intactos.  Reconstruir: para cada extra original, contar cuantas
        // inserciones se hicieron en posiciones <= original_pos.
        // SIMPLIFICACION: dejamos extras tal cual; cada uno tendra el offset
        // post-insert que ya esta correcto si NO insertamos entre ellos.
        // Pero como ejecutamos uno a uno con b.cursor, las extras quedan
        // desfasadas.  Hack: recomputar usando la posicion final del primario.
        // Para evitar complicaciones, simplemente limpiamos extras tras N
        // inserciones consecutivas (UX: el usuario debe re-anadirlas).
        free(all);
        // Estrategia simple: incrementar cada extra por 1 (porque insertamos
        // un char a cada uno; el primario ya se shifteo por su insert).
        // Pero las extras tambien fueron usadas como cursores -- estan ya
        // shifteadas?  Mejor: el conteo de operaciones aplicadas == n.
        // Recomputamos extras leyendo desde all[] post-sort_desc.  Pero
        // perdimos all[].  Simplificacion final: limpiar extras.
        this.count = 0;
        return n;
    }

    // Backspace en TODOS.  Similar logica que insert_char.
    public i32 backspace_at_all(buffer.Buffer b) {
        if (this.count == 0) {
            b.backspace();
            return 1;
        }
        i32* all = malloc((MC_MAX + 1) * 4);
        i32 n = 0;
        all[n] = b.cursor; n = n + 1;
        i32 j = 0;
        while (j < this.count) { all[n] = this.offsets[j]; n = n + 1; j = j + 1; }
        i32 a = 0;
        while (a < n) {
            i32 bb = a + 1;
            while (bb < n) {
                if (all[bb] > all[a]) {
                    i32 t = all[a]; all[a] = all[bb]; all[bb] = t;
                }
                bb = bb + 1;
            }
            a = a + 1;
        }
        i32 k = 0;
        while (k < n) {
            b.cursor = all[k];
            if (b.cursor > 0) b.backspace();
            k = k + 1;
        }
        free(all);
        this.count = 0;
        return n;
    }

    // Reset y vacia extras (alias de clear para uso semantico).
    public void reset(buffer.Buffer b) {
        this.count = 0;
    }
}
