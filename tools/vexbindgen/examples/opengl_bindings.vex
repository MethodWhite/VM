    @Extern("opengl32:glAttachShader")
    fn glAttachShader(program: u32, shader: u32)

    @Extern("opengl32:glLinkProgram")
    fn glLinkProgram(program: u32)

    @Extern("opengl32:glUseProgram")
    fn glUseProgram(program: u32)

    @Extern("opengl32:glDeleteShader")
    fn glDeleteShader(shader: u32)

    @Extern("opengl32:glDeleteProgram")
    fn glDeleteProgram(program: u32)

    // --- Buffers ---

    @Extern("opengl32:glGenBuffers")
    fn glGenBuffers(count: i32, buffers_ptr: u64)

    @Extern("opengl32:glBindBuffer")
    fn glBindBuffer(target: u32, buffer: u32)

    @Extern("opengl32:glBufferData")
    fn glBufferData(target: u32, size: i64, data_ptr: u64, usage: u32)

    @Extern("opengl32:glDeleteBuffers")
    fn glDeleteBuffers(count: i32, buffers_ptr: u64)

    // --- Vertex arrays ---

    @Extern("opengl32:glGenVertexArrays")
    fn glGenVertexArrays(count: i32, arrays_ptr: u64)

    @Extern("opengl32:glBindVertexArray")
    fn glBindVertexArray(array: u32)

    @Extern("opengl32:glEnableVertexAttribArray")
    fn glEnableVertexAttribArray(index: u32)

    @Extern("opengl32:glDisableVertexAttribArray")
    fn glDisableVertexAttribArray(index: u32)

    @Extern("opengl32:glVertexAttribPointer")
    fn glVertexAttribPointer(
        index: u32, size: i32, type_val: u32,
        normalized: u8, stride: i32, pointer_ptr: u64
    )

    // --- Drawing ---

    @Extern("opengl32:glDrawArrays")
    fn glDrawArrays(mode: u32, first: i32, count: i32)

    @Extern("opengl32:glDrawElements")
    fn glDrawElements(mode: u32, count: i32, type_val: u32, indices_ptr: u64)

