// =============================================================================
// modules/history.vex - pila de snapshots para deshacer
// =============================================================================
//
// Cada snapshot es una copia COMPLETA del buffer (bytes + cursor +
// dirty).  Capacidad fija MAX_UNDO (64); cuando se llena, los
// snapshots mas antiguos se descartan (ring buffer).

import "modules/buffer";

public struct Snapshot {
    i32 length;
    i32 cursor;
    i32 dirty;
    u8* data;       // copia owned via malloc
}

@cold public comptime i32 MAX_UNDO = 64;

public class SnapshotStack {
    public Snapshot* slots;
    public i32       count;
    public i32       capacity;

    public SnapshotStack() {
        this.capacity = MAX_UNDO;
        this.slots    = malloc(MAX_UNDO * 24);   // sizeof(Snapshot)=24
        this.count    = 0;
    }

    // Libera todos los `data` activos + el array de slots al destruir
    // la pila.  Sin esto, cerrar el editor con undos pendientes deja
    // bytes huerfanos en el heap raw del proceso.
    public ~SnapshotStack() {
        if (this.slots != null) {
            i32 i = 0;
            while (i < this.count) {
                if (this.slots[i].data != null) free(this.slots[i].data);
                i = i + 1;
            }
            free(this.slots);
        }
    }

    public i32 size() { return this.count; }
    public i32 empty() {
        if (this.count == 0) return 1;
        return 0;
    }
}

// Llena `out` con un snapshot del buffer actual.
public void make_snapshot_into(buffer.Buffer b, VirtualPtr<Snapshot> out) {
    (*out).length = b.length;
    (*out).cursor = b.cursor;
    (*out).dirty  = b.dirty;
    (*out).data   = malloc(b.length + 1);
    i32 i = 0;
    while (i < b.length) {
        (*out).data[i] = b.data[i];
        i = i + 1;
    }
    (*out).data[b.length] = 0;
}

// Push.  Si el stack esta lleno, descarta el mas antiguo (shift).
public void stack_push(SnapshotStack st, VirtualPtr<Snapshot> snap) {
    if (st.count >= st.capacity) {
        // Shift: descartar el mas viejo, free su data, mover el resto.
        free(st.slots[0].data);
        i32 i = 0;
        while (i < st.count - 1) {
            st.slots[i] = st.slots[i + 1];
            i = i + 1;
        }
        st.count = st.count - 1;
    }
    st.slots[st.count] = *snap;
    st.count = st.count + 1;
}

// Pop al final.  Devuelve 1 si OK, 0 si vacio.
public i32 stack_pop_into(SnapshotStack st, VirtualPtr<Snapshot> out) {
    if (st.count == 0) return 0;
    st.count = st.count - 1;
    *out = st.slots[st.count];
    return 1;
}

// Restaura el buffer al estado del snapshot.  Libera el data anterior
// del buffer y adopta el data del snapshot (move ownership).
public void restore(buffer.Buffer b, VirtualPtr<Snapshot> snap) {
    free(b.data);
    b.data     = (*snap).data;
    b.length   = (*snap).length;
    b.cursor   = (*snap).cursor;
    b.dirty    = (*snap).dirty;
    b.capacity = (*snap).length + 1;
}

// Libera todos los snapshots del stack (data + slots) sin destruir el
// stack en si.  Usado para limpiar el redo_stack cuando llega una nueva
// edicion del usuario.
public void stack_clear(SnapshotStack st) {
    i32 i = 0;
    while (i < st.count) {
        if (st.slots[i].data != null) free(st.slots[i].data);
        i = i + 1;
    }
    st.count = 0;
}
