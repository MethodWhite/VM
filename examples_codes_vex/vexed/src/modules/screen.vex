// =============================================================================
// modules/screen.vex - render TUI fullscreen via ANSI escapes + tamano dinamico
// =============================================================================
//
// Consulta el tamano de consola via kernel32.GetConsoleScreenBufferInfo.
// Si la API falla, defaults a 100x30.  Toda la salida es ANSI con
// secuencias inline.

import "modules/buffer";
import "modules/syntax";

public comptime string CLEAR_SCREEN = "\x1b[2J";
public comptime string CURSOR_HOME  = "\x1b[H";
public comptime string CURSOR_HIDE  = "\x1b[?25l";
public comptime string CURSOR_SHOW  = "\x1b[?25h";
public comptime string ATTR_RESET   = "\x1b[0m";
public comptime string ATTR_INVERT  = "\x1b[7m";
public comptime string ATTR_BOLD    = "\x1b[1m";
public comptime string ATTR_DIM     = "\x1b[2m";
public comptime string FG_RED       = "\x1b[31m";
public comptime string FG_GREEN     = "\x1b[32m";
public comptime string FG_YELLOW    = "\x1b[33m";
public comptime string FG_BLUE      = "\x1b[34m";
public comptime string FG_CYAN      = "\x1b[36m";
public comptime string FG_GRAY      = "\x1b[90m";

public class Screen {
    public i64 lib_kernel32;
    public i64 sym_getstdhandle;
    public i64 sym_getbufinfo;
    public i64 hstdout;
    public i32 cols;
    public i32 rows;

    public Screen() {
        this.lib_kernel32     = ffi_open("kernel32.dll");
        this.sym_getstdhandle = ffi_sym(this.lib_kernel32, "GetStdHandle");
        this.sym_getbufinfo   = ffi_sym(this.lib_kernel32, "GetConsoleScreenBufferInfo");
        this.hstdout          = ffi_call(this.sym_getstdhandle, -11);  // STD_OUTPUT_HANDLE
        this.cols             = 100;
        this.rows             = 30;
        this.refresh_size();
    }

    // Helper: lee i16 LE desde buf+off con sign extend.
    public i32 read_i16_le(u8* buf, i32 off) {
        i32 lo = buf[off];
        i32 hi = buf[off + 1];
        i32 v  = (hi << 8) | lo;
        if ((v & 0x8000) != 0) v = v | 0xFFFF0000;
        return v;
    }

    // Actualiza cols/rows leyendo CONSOLE_SCREEN_BUFFER_INFO (22 bytes).
    public void refresh_size() {
        if (this.hstdout == 0) return;
        u8* info = malloc(22);
        i32 z = 0;
        while (z < 22) { info[z] = 0; z = z + 1; }
        i64 ok = ffi_call(this.sym_getbufinfo, this.hstdout, info);
        if (ok == 0) {
            free(info);
            return;
        }
        i32 left   = this.read_i16_le(info, 10);
        i32 top    = this.read_i16_le(info, 12);
        i32 right  = this.read_i16_le(info, 14);
        i32 bottom = this.read_i16_le(info, 16);
        i32 nc = right  - left + 1;
        i32 nr = bottom - top  + 1;
        if (nc > 0 && nc < 1024) this.cols = nc;
        if (nr > 0 && nr < 1024) this.rows = nr;
        free(info);
    }

    public void clear() {
        print(CLEAR_SCREEN);
        print(CURSOR_HOME);
    }

    public void hide_cursor() { print(CURSOR_HIDE); }
    public void show_cursor() { print(CURSOR_SHOW); }

    // Posiciona el cursor en (row, col) 1-based estilo ANSI.
    public void move_cursor(i32 row, i32 col) {
        print("\x1b[${row};${col}H");
    }

    // Borra desde la posicion actual hasta el final de la linea.
    public void clear_eol() {
        print("\x1b[K");
    }

    // Renderiza el status bar (linea inferior) invertido.
    public void render_status(buffer.Buffer b, string title) {
        this.move_cursor(this.rows, 1);
        print(ATTR_INVERT);
        i32 line  = b.cursor_row() + 1;
        i32 col   = b.cursor_col() + 1;
        i32 total = b.line_count();
        string mark = " ";
        if (b.dirty == 1) mark = "*";
        print(" ${mark} ${title}  L${line}:C${col}/${total} ");
        print(ATTR_RESET);
        this.clear_eol();
    }

    // Renderiza una linea del buffer en la fila visual `screen_row`,
    // empezando en la columna `screen_col` (1-based).  La linea inicia
    // en `byte_start` del buffer y termina al primer LF o al final.
    // Si hay seleccion activa, resalta los bytes [sel_start, sel_end).
    public void render_line_at(buffer.Buffer b, i32 byte_start, i32 screen_row,
                                i32 screen_col) {
        this.move_cursor(screen_row, screen_col);
        i32 sel_on = b.sel_active();
        i32 ss = 0;
        i32 se = 0;
        if (sel_on == 1) {
            ss = b.sel_start();
            se = b.sel_end();
        }
        i32 in_invert = 0;
        i32 i = byte_start;
        i32 col = 0;
        i32 max_col = this.cols - screen_col;
        while (i < b.length && col < max_col) {
            i32 c = (i32) b.data[i];
            if (sel_on == 1) {
                i32 want = 0;
                if (i >= ss && i < se) want = 1;
                if (want == 1 && in_invert == 0) {
                    print(ATTR_INVERT);
                    in_invert = 1;
                } else if (want == 0 && in_invert == 1) {
                    print(ATTR_RESET);
                    in_invert = 0;
                }
            }
            if (c == 10) {
                if (in_invert == 1) print(ATTR_RESET);
                this.clear_eol();
                return;
            }
            if (c >= 32 && c < 127) {
                print_char(c);
            } else if (c == 9) {
                print(" ");
            } else {
                print(".");
            }
            i = i + 1;
            col = col + 1;
        }
        if (in_invert == 1) print(ATTR_RESET);
        this.clear_eol();
    }

    // Compatibilidad: render_line antiguo usa col=1.
    public void render_line(buffer.Buffer b, i32 byte_start, i32 screen_row) {
        this.render_line_at(b, byte_start, screen_row, 1);
    }

    // Renderiza una linea con syntax highlighting via SyntaxHighlighter.
    // El `hl` mantiene estado multilinea (block comments, triple strings)
    // que el caller debe haber inicializado con `hl.reset_state()` al
    // inicio del render del frame.
    public void render_line_hl(buffer.Buffer b, i32 byte_start, i32 screen_row,
                                 i32 screen_col, syntax.SyntaxHighlighter hl) {
        this.move_cursor(screen_row, screen_col);
        i32 sel_on = b.sel_active();
        i32 ss = 0;
        i32 se = 0;
        if (sel_on == 1) {
            ss = b.sel_start();
            se = b.sel_end();
        }
        i32 max_chars = this.cols - screen_col;
        if (hl == null || hl.enabled == 0) {
            // Fallback al render plano.
            this.render_line_at(b, byte_start, screen_row, screen_col);
            return;
        }
        hl.render_line(b.data, b.length, byte_start, sel_on, ss, se, max_chars);
        this.clear_eol();
    }

    // F8 (whitespace viz): render plain con marcadores visibles para tabs y
    // trailing spaces.  Sacrifica syntax highlighting a cambio de visualizar
    // los espacios "fantasma".  Tabs -> `>` + spaces hasta el siguiente
    // tabstop de 4 cols (en color cyan dim).  Trailing spaces -> `.` (cyan dim).
    public void render_line_with_ws(buffer.Buffer b, i32 byte_start, i32 screen_row,
                                     i32 screen_col) {
        this.move_cursor(screen_row, screen_col);
        i32 sel_on = b.sel_active();
        i32 ss = 0;
        i32 se = 0;
        if (sel_on == 1) {
            ss = b.sel_start();
            se = b.sel_end();
        }
        i32 max_chars = this.cols - screen_col;

        // Encontrar fin de linea (offset del LF o length si ultima linea).
        i32 line_end = byte_start;
        while (line_end < b.length && b.data[line_end] != 10) {
            line_end = line_end + 1;
        }
        // Buscar la ultima posicion no-whitespace para identificar trailing
        // spaces (sustituyen con marcador solo entre last_non_ws+1 y line_end).
        i32 last_non_ws = byte_start - 1;
        i32 z = byte_start;
        while (z < line_end) {
            u8 cz = b.data[z];
            if (cz != 32 && cz != 9) last_non_ws = z;
            z = z + 1;
        }

        // Color para markers de whitespace (Dracula comment-gray + dim).
        string col_ws = "\x1b[38;2;98;114;164m";
        string col_fg = "\x1b[38;2;248;248;242m";

        i32 i = byte_start;
        i32 col = 0;
        i32 in_invert = 0;
        i32 in_ws = 0;
        while (i < line_end && col < max_chars) {
            // Aplicar/desaplicar INVERT para seleccion.
            if (sel_on == 1) {
                i32 want = 0;
                if (i >= ss && i < se) want = 1;
                if (want == 1 && in_invert == 0) { print("\x1b[7m"); in_invert = 1; }
                else if (want == 0 && in_invert == 1) { print(ATTR_RESET); in_invert = 0; in_ws = 0; }
            }
            u8 c = b.data[i];
            if (c == 9) {
                // Tab: marcador `>` + padding hasta el siguiente tabstop 4.
                if (in_ws == 0) { print(col_ws); in_ws = 1; }
                print_char(62);                            // '>'
                col = col + 1;
                // Tabstop a 4 cols: rellenar con espacios hasta col % 4 == 0.
                while ((col % 4) != 0 && col < max_chars) {
                    print(" ");
                    col = col + 1;
                }
            } else if (c == 32 && i > last_non_ws) {
                // Trailing space: marcador `.`.
                if (in_ws == 0) { print(col_ws); in_ws = 1; }
                print_char(46);                            // '.'
                col = col + 1;
            } else {
                // Caracter normal.
                if (in_ws == 1) { print(ATTR_RESET); if (in_invert == 1) print("\x1b[7m"); else print(col_fg); in_ws = 0; }
                if (c >= 32 && c < 127) print_char((i32) c);
                else                     print_char(46);   // chars no imprimibles
                col = col + 1;
            }
            i = i + 1;
        }
        if (in_invert == 1 || in_ws == 1) print(ATTR_RESET);
        this.clear_eol();
    }
}
