// -----------------------------------------------------------------
//  Server mode
// -----------------------------------------------------------------

/// Write a simple HTTP server script for previewing docs
fn write_server_script(docs_dir: string) {
    // Write a Python-based HTTP server script for convenience
    let script: string = ""
    script = script ++ "#!/usr/bin/env python3\n"
    script = script ++ "import http.server\n"
    script = script ++ "import socketserver\n"
    script = script ++ "import os\n\n"
    script = script ++ "PORT = 8080\n"
    script = script ++ "DIR = " ++ "\"" ++ docs_dir ++ "\"\n\n"
    script = script ++ "os.chdir(DIR)\n"
    script = script ++ "Handler = http.server.SimpleHTTPRequestHandler\n"
    script = script ++ "with socketserver.TCPServer((\"\", PORT), Handler) as httpd:\n"
    script = script ++ "    print(\"VexDoc server running at http://localhost:\" + str(PORT))\n"
    script = script ++ "    httpd.serve_forever()\n"

    std.io.write_all(docs_dir ++ "/serve.py", script)
}

// -----------------------------------------------------------------
//  Main entry point
// -----------------------------------------------------------------

i32 main() {
    // Get command-line arguments (in Vex this comes from the runtime)
    // For now, we read from the standard args mechanism
    let args = std.system.args()
    let cli = parse_args(args)

    if cli.input.size() == 0 && cli.mode != "serve" {
        std.io.println("VexDoc - Vex Documentation Generator")
        std.io.println("")
        std.io.println("Usage:")
        std.io.println("  vexdoc file.vex                  Generate markdown docs (stdout)")
        std.io.println("  vexdoc --html file.vex -o docs/  Generate HTML output")
        std.io.println("  vexdoc --project src/ -o docs/   Generate docs for entire project")
        std.io.println("  vexdoc --serve docs/             Start preview server")
        return 1
    }

    if cli.mode == "serve" {
        // Start HTTP server
        std.io.println("Starting VexDoc server...")
        write_server_script(cli.output_dir)
        std.io.println("Server script written to: " ++ cli.output_dir ++ "/serve.py")
        std.io.println("Run: python3 " ++ cli.output_dir ++ "/serve.py")
        return 0
    }

    if cli.mode == "project" {
        // Generate docs for all .vex files in project directory
        std.io.println("Scanning project: " ++ cli.input)
        let files = enumerate_project(cli.input)
        if files.size() == 0 {
            std.io.println("Warning: No .vex files found. Processing explicitly provided paths.")
        }

        // Process each file and generate HTML
        let mut modules: extract.ModuleDoc[] = []
        let mut i: i32 = 0
        while i < files.size() {
            let f = files[i]
            std.io.println("  Processing: " ++ f)
            let mod = extract.extract_file(f)
            modules = modules ++ [mod]
            i = i + 1
        }

        if modules.size() > 0 {
            std.io.println("Generating HTML documentation...")
            std.io.write_all(cli.output_dir, "")
            html_gen.write_all_pages(modules, cli.output_dir)
            std.io.println("Done. Output: " ++ cli.output_dir)
        }
        return 0
    }

    // Process single input file
    if cli.input.size() == 0 {
        std.io.println("Error: No input file specified.")
        return 1
    }

    // Check if file exists
    if !std.io.exists(cli.input) {
        std.io.println("Error: File not found: " ++ cli.input)
        return 1
    }

    if cli.mode == "markdown" {
        // Generate markdown to stdout
        let mod = extract.extract_file(cli.input)
        let md = generate_markdown(mod)
        std.io.print(md)
        return 0
    }

    if cli.mode == "html" {
        // Generate HTML output
        std.io.println("Generating HTML documentation for: " ++ cli.input)
        let mod = extract.extract_file(cli.input)
        let modules = [mod]
        html_gen.write_all_pages(modules, cli.output_dir)
        std.io.println("Done. Output: " ++ cli.output_dir ++ "/index.html")
        return 0
    }

    return 0
}
