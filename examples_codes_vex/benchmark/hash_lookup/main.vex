// Bench: hash lookup simulado (FNV-style int ops).
// 50M iter con 6 int ops + 1 branch por iter = 350M ops totales.

i32 main() {
    u64 seed = 0xCAFEBABE_DEADBEEF;
    u64 acc = 0;
    i32 i = 0;
    while (i < 50000000) {
        seed = seed ^ (u64) i;
        seed = seed * 1099511628211;
        seed = seed >> 7;
        seed = seed | 1;
        if ((seed & 7) == 0) {
            acc = acc + 1;
        }
        i = i + 1;
    }
    return (i32) acc;
}
