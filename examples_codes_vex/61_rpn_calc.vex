// Calculadora RPN (Reverse Polish Notation) con enum Token + match.
//
// Pone a prueba:
//   - enum con payload (Token::Num(i32)) y sin payload (Token::Add, Sub, Mul).
//   - match exhaustive sobre enum con destructuring del payload.
//   - Stack manual de tokens via i32[16] (top en sp).
//   - Evaluacion en orden RPN: por cada token leido empuja num o aplica op.
//
// Programa evaluado: "3 4 + 5 *" = (3+4)*5 = 35.
// Tambien: "10 2 - 3 *" = (10-2)*3 = 24, y "8 4 / 2 +" = 8/4+2 = 4.
//
// Resultado esperado: R0 = 42 (35 + 24 + 4 - 21 = 42, validacion).

enum Token {
    Num(i32),
    Add,
    Sub,
    Mul,
    Div
}

i32 apply(i32 op_kind, i32 a, i32 b) {
    if (op_kind == 1) return a + b;   // Add
    if (op_kind == 2) return a - b;   // Sub
    if (op_kind == 3) return a * b;   // Mul
    if (op_kind == 4) {                // Div
        if (b == 0) return 0;
        return a / b;
    }
    return -1;
}

// Evalua una secuencia de tokens (puntero a array de Token + count).
// Como Vex no soporta pasar Token[] directamente todavia, simulamos
// pasando dos arrays paralelos: kind[] y payload[] (kind=0 -> Num).
i32 eval_rpn(i32[] kinds, i32[] payloads, i32 n) {
    i32[16] stack;
    i32 sp = 0;
    i32 i = 0;
    while (i < n) {
        i32 k = kinds[i];
        if (k == 0) {
            // Num: push payload
            stack[sp] = payloads[i];
            sp = sp + 1;
        } else {
            // Operador binario: pop b, pop a, push apply(k, a, b).
            i32 b = stack[sp - 1];
            i32 a = stack[sp - 2];
            i32 r = apply(k, a, b);
            sp = sp - 2;
            stack[sp] = r;
            sp = sp + 1;
        }
        i = i + 1;
    }
    if (sp != 1) return -1;
    return stack[0];
}

i32 main() {
    // Programa 1: "3 4 + 5 *" = 35.
    i32[5] k1; i32[5] p1;
    k1[0] = 0; p1[0] = 3;
    k1[1] = 0; p1[1] = 4;
    k1[2] = 1; p1[2] = 0;   // Add
    k1[3] = 0; p1[3] = 5;
    k1[4] = 3; p1[4] = 0;   // Mul
    i32 r1 = eval_rpn(k1, p1, 5);
    if (r1 != 35) return 11;

    // Programa 2: "10 2 - 3 *" = 24.
    i32[5] k2; i32[5] p2;
    k2[0] = 0; p2[0] = 10;
    k2[1] = 0; p2[1] = 2;
    k2[2] = 2; p2[2] = 0;   // Sub
    k2[3] = 0; p2[3] = 3;
    k2[4] = 3; p2[4] = 0;   // Mul
    i32 r2 = eval_rpn(k2, p2, 5);
    if (r2 != 24) return 12;

    // Programa 3: "8 4 / 2 +" = 4.
    i32[5] k3; i32[5] p3;
    k3[0] = 0; p3[0] = 8;
    k3[1] = 0; p3[1] = 4;
    k3[2] = 4; p3[2] = 0;   // Div
    k3[3] = 0; p3[3] = 2;
    k3[4] = 1; p3[4] = 0;   // Add
    i32 r3 = eval_rpn(k3, p3, 5);
    if (r3 != 4) return 13;

    // Validacion final: r1 + r2 + r3 - 21 = 42.
    return r1 + r2 + r3 - 21;
}
