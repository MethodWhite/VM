// std.string.vex - String manipulation utilities for Vex

namespace std.string {

    /// Split string by delimiter
    fn split(s: string, delim: string) -> string[] {
        let mut result: string[] = []
        let mut current: string = ""
        let mut i: i32 = 0
        while i < s.size() {
            let mut match = true
            let mut j: i32 = 0
            while j < delim.size() {
                if i + j >= s.size() || s[i + j] != delim[j] {
                    match = false
                    break
                }
                j = j + 1
            }
            if match {
                result = result ++ [current]
                current = ""
                i = i + delim.size()
            } else {
                current = current ++ s[i]
                i = i + 1
            }
        }
        result = result ++ [current]
        return result
    }

    /// Join array of strings with delimiter
    @Inline
    fn join(parts: string[], delim: string) -> string {
        let mut result: string = ""
        let mut i: i32 = 0
        while i < parts.size() {
            if i > 0 { result = result ++ delim }
            result = result ++ parts[i]
            i = i + 1
        }
        return result
    }

    /// Check if string starts with prefix
    @Inline
    fn starts_with(s: string, prefix: string) -> bool {
        if prefix.size() > s.size() { return false }
        let mut i: i32 = 0
        while i < prefix.size() {
            if s[i] != prefix[i] { return false }
            i = i + 1
        }
        return true
    }

    /// Check if string ends with suffix
    @Inline
    fn ends_with(s: string, suffix: string) -> bool {
        if suffix.size() > s.size() { return false }
        let offset = s.size() - suffix.size()
        let mut i: i32 = 0
        while i < suffix.size() {
            if s[offset + i] != suffix[i] { return false }
            i = i + 1
        }
        return true
    }

    /// Trim whitespace from start and end
    fn trim(s: string) -> string {
        return trim_end(trim_start(s))
    }

    fn trim_start(s: string) -> string {
        let mut i: i32 = 0
        while i < s.size() && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n') {
            i = i + 1
        }
        return s[i..]
    }

    fn trim_end(s: string) -> string {
        let mut i = s.size() - 1
        while i >= 0 && (s[i] == ' ' || s[i] == '\t' || s[i] == '\n') {
            i = i - 1
        }
        return s[0..i+1]
    }

    /// Convert to lowercase
    fn to_lower(s: string) -> string {
        let mut result: string = ""
        let mut i: i32 = 0
        while i < s.size() {
            let c = s[i]
            if c >= 'A' && c <= 'Z' {
                result = result ++ char(i32(c) + 32)
            } else {
                result = result ++ c
            }
            i = i + 1
        }
        return result
    }

    /// Convert to uppercase
    fn to_upper(s: string) -> string {
        let mut result: string = ""
        let mut i: i32 = 0
        while i < s.size() {
            let c = s[i]
            if c >= 'a' && c <= 'z' {
                result = result ++ char(i32(c) - 32)
            } else {
                result = result ++ c
            }
            i = i + 1
        }
        return result
    }

    /// Replace all occurrences
    fn replace(s: string, from: string, to: string) -> string {
        let parts = split(s, from)
        return join(parts, to)
    }

    /// Reverse string
    fn reverse(s: string) -> string {
        let mut result: string = ""
        let mut i = s.size() - 1
        while i >= 0 {
            result = result ++ s[i]
            i = i - 1
        }
        return result
    }

} // namespace std.string
